<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-5); flex-wrap: wrap; gap: var(--space-3);">
  <h1 style="margin: 0;">Audit log</h1>
  <a href="/admin" class="btn btn--ghost">← Back to admin</a>
</div>

<div class="card" style="margin-bottom: var(--space-5);">
  <form method="get" action="/admin/audit" style="display: flex; gap: var(--space-3); align-items: flex-end; flex-wrap: wrap;">
    <div class="field" style="margin: 0; flex-grow: 1; min-width: 200px;">
      <label for="actor">Actor email</label>
      <input id="actor" name="actor" type="search" value="<%= filters.actor %>">
    </div>
    <div class="field" style="margin: 0;">
      <label for="action">Action</label>
      <select id="action" name="action">
        <option value="">Any</option>
        <% actions.forEach((a) => { %>
          <option value="<%= a %>" <%= filters.action === a ? 'selected' : '' %>><%= a %></option>
        <% }) %>
      </select>
    </div>
    <button type="submit" class="btn btn--primary" style="height: 44px;">Filter</button>
    <a href="/admin/audit" class="btn btn--ghost" style="height: 44px; line-height: 44px;">Reset</a>
  </form>
</div>

<div class="card" style="padding: 0; overflow-x: auto;">
  <table class="data-table">
    <thead>
      <tr>
        <th>When</th>
        <th>Actor</th>
        <th>Action</th>
        <th>Target</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% result.rows.forEach((a) => { %>
        <tr>
          <td data-label="When"><%= new Date(a.occurred_at).toLocaleString('en-GB') %></td>
          <td data-label="Actor"><%= a.actor_email || '—' %></td>
          <td data-label="Action"><span class="badge badge--muted"><%= a.action %></span></td>
          <td data-label="Target"><%= a.target_type || '—' %></td>
          <td style="text-align: right;">
            <a href="/admin/audit/<%= a.id %>" class="btn btn--ghost btn--sm">View</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>