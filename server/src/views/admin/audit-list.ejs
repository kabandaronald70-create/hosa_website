<h1>Audit log</h1>

<p><a href="/admin">← Back to admin</a></p>

<form method="get" action="/admin/audit">
  <fieldset>
    <legend>Filter</legend>

    <label for="actor">Actor email contains</label>
    <input id="actor" name="actor" type="search" value="<%= filters.actor %>">

    <label for="action">Action</label>
    <select id="action" name="action">
      <option value="">Any</option>
      <% actions.forEach((a) => { %>
        <option value="<%= a %>" <%= filters.action === a ? 'selected' : '' %>><%= a %></option>
      <% }) %>
    </select>

    <label for="targetType">Target type</label>
    <select id="targetType" name="targetType">
      <option value="">Any</option>
      <% targetTypes.forEach((t) => { %>
        <option value="<%= t %>" <%= filters.targetType === t ? 'selected' : '' %>><%= t %></option>
      <% }) %>
    </select>

    <label for="from">From (date)</label>
    <input id="from" name="from" type="date" value="<%= filters.from %>">

    <label for="to">To (date)</label>
    <input id="to" name="to" type="date" value="<%= filters.to %>">

    <p>
      <button type="submit">Apply</button>
      <a href="/admin/audit">Reset</a>
      <a href="/admin/audit/export.csv?<%= new URLSearchParams(filters).toString() %>">Export CSV</a>
    </p>
  </fieldset>
</form>

<p>
  <%= result.total %> entr<%= result.total === 1 ? 'y' : 'ies' %>
  — page <%= result.page %> of <%= result.pages %>.
</p>

<table>
  <thead>
    <tr>
      <th>When</th>
      <th>Actor</th>
      <th>Action</th>
      <th>Target</th>
      <th>IP</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% result.rows.forEach((a) => { %>
      <tr>
        <td><%= new Date(a.occurred_at).toLocaleString() %></td>
        <td><%= a.actor_email || '—' %></td>
        <td><code><%= a.action %></code></td>
        <td>
          <%= a.target_type || '—' %>
          <% if (a.target_id) { %> <small>(<%= a.target_id.slice(0, 8) %>…)</small><% } %>
        </td>
        <td><%= a.ip_address || '—' %></td>
        <td><a href="/admin/audit/<%= a.id %>">View</a></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<% if (result.pages > 1) { %>
  <nav aria-label="Pagination">
    <% if (result.page > 1) { %>
      <a href="?<%= new URLSearchParams({ ...filters, page: String(result.page - 1) }).toString() %>">← Previous</a>
    <% } %>
    <% if (result.page < result.pages) { %>
      <a href="?<%= new URLSearchParams({ ...filters, page: String(result.page + 1) }).toString() %>">Next →</a>
    <% } %>
  </nav>
<% } %>