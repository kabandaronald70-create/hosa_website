<h1>Events</h1>

<p><a href="/admin/events/new" class="btn">+ New event</a></p>

<form method="get" action="/admin/events">
  <fieldset>
    <legend>Filter</legend>

    <label for="q">Search by title</label>
    <input id="q" name="q" type="search" value="<%= filters.q %>">

    <label for="status">Status</label>
    <select id="status" name="status">
      <option value=""          <%= !filters.status ? 'selected' : '' %>>Any</option>
      <option value="draft"     <%= filters.status === 'draft' ? 'selected' : '' %>>Draft</option>
      <option value="published" <%= filters.status === 'published' ? 'selected' : '' %>>Published</option>
      <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
      <option value="archived"  <%= filters.status === 'archived' ? 'selected' : '' %>>Archived</option>
    </select>

    <label for="when">Time</label>
    <select id="when" name="when">
      <option value=""         <%= !filters.when ? 'selected' : '' %>>Any</option>
      <option value="upcoming" <%= filters.when === 'upcoming' ? 'selected' : '' %>>Upcoming</option>
      <option value="past"     <%= filters.when === 'past' ? 'selected' : '' %>>Past</option>
    </select>

    <p><button type="submit">Apply</button>
       <a href="/admin/events">Reset</a></p>
  </fieldset>
</form>

<p><%= result.total %> event<%= result.total === 1 ? '' : 's' %> — page <%= result.page %> of <%= result.pages %>.</p>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Starts</th>
      <th>Venue</th>
      <th>Status</th>
      <th>Published</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% result.rows.forEach((e) => { %>
      <tr>
        <td><%= e.title %></td>
        <td><%= new Date(e.starts_at).toLocaleString() %></td>
        <td><%= e.venue || '—' %></td>
        <td><%= e.status %></td>
        <td><%= e.published_at ? new Date(e.published_at).toLocaleString() : '—' %></td>
        <td><a href="/admin/events/<%= e.id %>">Open</a></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<% if (result.pages > 1) { %>
  <nav aria-label="Pagination">
    <% if (result.page > 1) { %>
      <a href="?<%= new URLSearchParams({ ...filters, page: String(result.page - 1) }).toString() %>">← Previous</a>
    <% } %>
    <% if (result.page < result.pages) { %>
      <a href="?<%= new URLSearchParams({ ...filters, page: String(result.page + 1) }).toString() %>">Next →</a>
    <% } %>
  </nav>
<% } %>