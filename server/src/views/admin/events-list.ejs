<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-5); flex-wrap: wrap; gap: var(--space-3);">
  <div style="display: flex; align-items: center; gap: var(--space-3);">
    <a href="/admin" class="btn btn--ghost" style="padding: var(--space-2);">←</a>
    <h1 style="margin: 0;">Events</h1>
  </div>
  <a href="/admin/events/new" class="btn btn--accent">+ New event</a>
</div>

<div class="card" style="margin-bottom: var(--space-5);">
  <form method="get" action="/admin/events" style="display: flex; gap: var(--space-3); align-items: flex-end; flex-wrap: wrap;">
    <div class="field" style="margin: 0; flex-grow: 1; min-width: 200px;">
      <label for="q">Search by title</label>
      <input id="q" name="q" type="search" value="<%= filters.q %>">
    </div>
    <div class="field" style="margin: 0;">
      <label for="status">Status</label>
      <select id="status" name="status">
        <option value="" <%= !filters.status ? 'selected' : '' %>>Any</option>
        <option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>>Draft</option>
        <option value="published" <%= filters.status === 'published' ? 'selected' : '' %>>Published</option>
        <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
        <option value="archived" <%= filters.status === 'archived' ? 'selected' : '' %>>Archived</option>
      </select>
    </div>
    <div class="field" style="margin: 0;">
      <label for="when">Time</label>
      <select id="when" name="when">
        <option value="" <%= !filters.when ? 'selected' : '' %>>Any</option>
        <option value="upcoming" <%= filters.when === 'upcoming' ? 'selected' : '' %>>Upcoming</option>
        <option value="past" <%= filters.when === 'past' ? 'selected' : '' %>>Past</option>
      </select>
    </div>
    <button type="submit" class="btn btn--primary" style="height: 44px;">Filter</button>
    <a href="/admin/events" class="btn btn--ghost" style="height: 44px; line-height: 44px;">Reset</a>
  </form>
</div>

<p style="color: var(--muted); margin-bottom: var(--space-3);">Showing <strong><%= result.total %></strong> events.</p>

<div class="card" style="padding: 0; overflow-x: auto;">
  <table class="data-table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Starts</th>
        <th>Venue</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% result.rows.forEach((e) => { %>
        <tr>
          <td data-label="Title"><strong><%= e.title %></strong></td>
          <td data-label="Starts"><%= new Date(e.starts_at).toLocaleString('en-GB', { dateStyle: 'medium' }) %></td>
          <td data-label="Venue"><%= e.venue || '—' %></td>
          <td data-label="Status">
            <% if (e.status === 'published') { %><span class="badge badge--success">Published</span>
            <% } else if (e.status === 'draft') { %><span class="badge badge--warning">Draft</span>
            <% } else { %><span class="badge badge--muted"><%= e.status %></span><% } %>
          </td>
          <td style="text-align: right;">
            <a href="/admin/events/<%= e.id %>" class="btn btn--ghost btn--sm">Manage</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>