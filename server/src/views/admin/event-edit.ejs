<div
  style="
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
    gap: var(--space-3);
  "
>
  <h1 style="margin: 0"><%= isNew ? 'New event' : 'Edit event' %></h1>
  <a href="/admin/events" class="btn btn--ghost">← Back to events</a>
</div>

<div class="card" style="max-width: 800px">
  <form
    method="post"
    action="<%= isNew ? '/admin/events/new' : `/admin/events/${event.id}/update` %>"
    novalidate
  >
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>" />

    <div class="field">
      <label for="title">Title</label>
      <input
        id="title"
        name="title"
        type="text"
        required
        maxlength="200"
        value="<%= values.title || '' %>"
      />
    </div>

    <div class="field">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="5" maxlength="5000">
<%= values.description || '' %></textarea
      >
    </div>

    <div
      class="responsive-fields"
      style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4)"
    >
      <div class="field">
        <label for="starts_at">Starts at</label>
        <input
          id="starts_at"
          name="starts_at"
          type="datetime-local"
          required
          value="<%= values.starts_at || '' %>"
        />
      </div>
      <div class="field">
        <label for="ends_at">Ends at (optional)</label>
        <input
          id="ends_at"
          name="ends_at"
          type="datetime-local"
          value="<%= values.ends_at || '' %>"
        />
      </div>
    </div>

    <div
      class="responsive-fields"
      style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4)"
    >
      <div class="field">
        <label for="venue">Venue</label>
        <input
          id="venue"
          name="venue"
          type="text"
          maxlength="300"
          value="<%= values.venue || '' %>"
        />
      </div>
      <div class="field">
        <label for="district">District</label>
        <input
          id="district"
          name="district"
          type="text"
          maxlength="120"
          value="<%= values.district || '' %>"
        />
      </div>
    </div>

    <div class="field">
      <label for="capacity">Capacity (optional)</label>
      <input
        id="capacity"
        name="capacity"
        type="number"
        min="1"
        value="<%= values.capacity || '' %>"
      />
    </div>

    <div style="margin-top: var(--space-5)">
      <button type="submit" class="btn btn--primary">
        <%= isNew ? 'Create Event' : 'Save Changes' %>
      </button>
    </div>
  </form>
</div>
