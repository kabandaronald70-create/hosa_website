<div
  style="
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
    gap: var(--space-3);
  "
>
  <div>
    <h1 style="margin: 0">Manage Event</h1>
    <p style="color: var(--muted); margin: var(--space-1) 0 0">
      <%= event.title %>
    </p>
  </div>
  <a href="/admin/events" class="btn btn--ghost">← Back to events</a>
</div>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: var(--space-5)">
  <div class="card">
    <h2 style="font-size: var(--text-lg); margin-top: 0">Details</h2>
    <p><strong>Status:</strong> <%= event.status %></p>
    <p>
      <strong>Starts:</strong> <%= new
      Date(event.starts_at).toLocaleString('en-GB') %>
    </p>
    <p><strong>Venue:</strong> <%= event.venue || '—' %></p>
    <p><strong>Description:</strong></p>
    <p style="white-space: pre-wrap; color: var(--muted)">
      <%= event.description %>
    </p>

    <div style="margin-top: var(--space-4)">
      <a
        href="/admin/events/<%= event.id %>/edit"
        class="btn btn--primary btn--sm"
        >Edit Details</a
      >
    </div>
  </div>

  <div>
    <div class="card" style="margin-bottom: var(--space-4)">
      <h2 style="font-size: var(--text-lg); margin-top: 0">RSVP Summary</h2>
      <p><strong><%= rsvps.going %></strong> going</p>
      <p><strong><%= rsvps.maybe %></strong> maybe</p>
      <p><strong><%= rsvps.cancelled %></strong> cancelled</p>
    </div>

    <div class="card">
      <h2 style="font-size: var(--text-lg); margin-top: 0">Actions</h2>
      <form
        method="post"
        action="/admin/events/<%= event.id %>/status"
        style="margin-bottom: var(--space-2)"
      >
        <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>" />
        <input
          type="hidden"
          name="status"
          value="<%= event.status === 'published' ? 'draft' : 'published' %>"
        />
        <button type="submit" class="btn btn--ghost" style="width: 100%">
          <%= event.status === 'published' ? 'Unpublish' : 'Publish' %>
        </button>
      </form>
      <form method="post" action="/admin/events/<%= event.id %>/status">
        <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>" />
        <input type="hidden" name="status" value="cancelled" />
        <button
          type="submit"
          class="btn btn--danger"
          style="width: 100%"
          onclick="return confirm('Cancel this event?');"
        >
          Cancel Event
        </button>
      </form>
    </div>
  </div>
</div>
