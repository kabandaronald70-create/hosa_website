<h1>Admin dashboard</h1>

<section aria-labelledby="stats-heading">
  <h2 id="stats-heading">At a glance</h2>
  <ul class="stat-grid">
    <li>
      <a href="/admin/members">
        <strong><%= counts.members.total %></strong> members
      </a>
    </li>
    <li>
      <a href="/admin/members?verified=yes">
        <strong><%= counts.members.verified %></strong> verified
      </a>
    </li>
    <li>
      <a href="/admin/members?status=suspended">
        <strong><%= counts.members.suspended %></strong> suspended
      </a>
    </li>
    <li>
  <a href="/admin/moderation">
    <strong><%= counts.pendingStories %></strong> pending stories
  </a>
</li>
<li>
  <a href="/admin/moderation">
    <strong><%= counts.pendingOpportunities %></strong> pending opportunities
  </a>
</li>
   <li>
  <a href="/admin/events?when=upcoming&amp;status=published">
    <strong><%= counts.upcomingEvents %></strong> upcoming events
  </a>
</li>
   <li>
  <a href="/admin/audit">
    <strong><%= counts.auditLast7Days %></strong> admin actions (7d)
  </a>
</li>
  </ul>
</section>

<nav aria-label="Admin sections">
  <h2>Manage</h2>
  <ul>
    <li><a href="/admin/members">Members</a></li>
    <li><a href="/admin/moderation">Moderation queue</a></li>
    <li><a href="/admin/events">Events</a></li>
    <li><a href="/admin/audit">Audit log</a></li>
  </ul>
</nav>

<section aria-labelledby="recent-heading">
  <h2 id="recent-heading">Recent admin actions</h2>
  <% if (recentAudits.length === 0) { %>
    <p><em>No admin actions yet.</em></p>
  <% } else { %>
    <table>
      <thead>
        <tr><th>When</th><th>Actor</th><th>Action</th><th>Target</th></tr>
      </thead>
      <tbody>
        <% recentAudits.forEach((a) => { %>
          <tr>
            <td><%= new Date(a.occurred_at).toLocaleString() %></td>
            <td><%= a.actor_email || '—' %></td>
            <td><code><%= a.action %></code></td>
            <td>
              <%= a.target_type || '—' %>
              <% if (a.target_id) { %> <small>(<%= a.target_id.slice(0, 8) %>…)</small><% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>