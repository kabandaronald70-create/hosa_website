<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-5); flex-wrap: wrap; gap: var(--space-3);">
  <h1 style="margin: 0;">Admin dashboard</h1>
</div>

<!-- Stats Grid -->
<section style="margin-bottom: var(--space-6);">
  <h2 style="font-size: var(--text-xl); margin-bottom: var(--space-3);">At a glance</h2>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--space-4);">
    
    <a href="/admin/members" class="card" style="text-decoration: none; color: inherit; text-align: center;">
      <div style="font-size: var(--text-2xl); font-weight: 700; color: var(--green);"><%= counts.members.total %></div>
      <div style="color: var(--muted); font-size: var(--text-sm);">Total Members</div>
    </a>

    <a href="/admin/members?verified=yes" class="card" style="text-decoration: none; color: inherit; text-align: center;">
      <div style="font-size: var(--text-2xl); font-weight: 700; color: var(--success);"><%= counts.members.verified %></div>
      <div style="color: var(--muted); font-size: var(--text-sm);">Verified</div>
    </a>

    <a href="/admin/members?status=suspended" class="card" style="text-decoration: none; color: inherit; text-align: center;">
      <div style="font-size: var(--text-2xl); font-weight: 700; color: var(--danger);"><%= counts.members.suspended %></div>
      <div style="color: var(--muted); font-size: var(--text-sm);">Suspended</div>
    </a>

    <a href="/admin/moderation" class="card" style="text-decoration: none; color: inherit; text-align: center;">
      <div style="font-size: var(--text-2xl); font-weight: 700; color: var(--warning);"><%= counts.pendingStories %></div>
      <div style="color: var(--muted); font-size: var(--text-sm);">Pending Stories</div>
    </a>

    <a href="/admin/moderation" class="card" style="text-decoration: none; color: inherit; text-align: center;">
      <div style="font-size: var(--text-2xl); font-weight: 700; color: var(--warning);"><%= counts.pendingOpportunities %></div>
      <div style="color: var(--muted); font-size: var(--text-sm);">Pending Jobs</div>
    </a>
  </div>
</section>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6);">
  
  <!-- Manage Section -->
  <section>
    <h2 style="font-size: var(--text-xl); margin-bottom: var(--space-3);">Manage</h2>
    <div class="card" style="padding: var(--space-2);">
      <a href="/admin/members" style="display: block; padding: var(--space-3); border-bottom: 1px solid var(--line); text-decoration: none; color: inherit; font-weight: 600;">👥 Members & Verification</a>
      <a href="/admin/moderation" style="display: block; padding: var(--space-3); border-bottom: 1px solid var(--line); text-decoration: none; color: inherit; font-weight: 600;">✅ Moderation Queue</a>
      <a href="/admin/events" style="display: block; padding: var(--space-3); border-bottom: 1px solid var(--line); text-decoration: none; color: inherit; font-weight: 600;">📅 Manage Events</a>
      <a href="/admin/audit" style="display: block; padding: var(--space-3); text-decoration: none; color: inherit; font-weight: 600;">📜 Audit Log</a>
    </div>
  </section>

  <!-- Recent Actions -->
  <section>
    <h2 style="font-size: var(--text-xl); margin-bottom: var(--space-3);">Recent admin actions</h2>
    <% if (recentAudits.length === 0) { %>
      <div class="empty-state" style="padding: var(--space-5);">
        <p style="margin: 0; color: var(--muted);">No recent admin actions.</p>
      </div>
    <% } else { %>
      <div class="card" style="padding: 0; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; font-size: var(--text-sm);">
          <tbody>
            <% recentAudits.forEach((a) => { %>
              <tr style="border-bottom: 1px solid var(--line);">
                <td style="padding: var(--space-3);">
                  <strong><%= a.action %></strong><br>
                  <span style="color: var(--muted); font-size: var(--text-xs);"><%= a.actor_email %> · <%= new Date(a.occurred_at).toLocaleString('en-GB') %></span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

</div>

<style>
  @media (max-width: 900px) {
    div[style*="grid-template-columns: 1fr 1fr"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>