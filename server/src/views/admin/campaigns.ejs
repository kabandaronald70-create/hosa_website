<style>
  .campaign-page,
  .campaign-list {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  .campaign-create-fields {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-3);
  }

  .campaign-date-range {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .campaign-date-range input {
    width: 100%;
    min-width: 0;
  }

  .campaign-card,
  .campaign-card > * {
    min-width: 0;
  }

  .campaign-card-header,
  .campaign-participant,
  .campaign-card-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }

  .campaign-card-header {
    align-items: flex-start;
    overflow-wrap: anywhere;
  }

  .campaign-participants {
    list-style: none;
    padding: 0;
    margin-bottom: var(--space-3);
  }

  .campaign-participant {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
  }

  .campaign-participant strong {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .campaign-add-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .campaign-add-form select {
    min-width: 0;
    max-width: 100%;
  }

  .campaign-card-actions {
    justify-content: flex-start;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    padding-top: var(--space-3);
  }

  .campaign-edit-panel {
    margin-top: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--ivory);
  }

  .campaign-edit-fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .campaign-edit-dates {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .campaign-edit-fields input,
  .campaign-edit-dates input,
  .campaign-edit-panel textarea {
    width: 100%;
    min-width: 0;
    padding: var(--space-2);
    border: 1px solid var(--line);
  }

  .campaign-edit-panel textarea {
    margin-bottom: var(--space-2);
  }

  .campaign-edit-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 700px) {
    .campaign-create-fields,
    .campaign-edit-fields {
      grid-template-columns: minmax(0, 1fr);
    }

    .campaign-card-header {
      flex-wrap: wrap;
    }

    .campaign-add-form {
      grid-template-columns: minmax(0, 1fr);
    }

    .campaign-add-form .btn {
      width: 100%;
    }
  }

  @media (max-width: 420px) {
    .campaign-date-range,
    .campaign-edit-dates {
      grid-template-columns: minmax(0, 1fr);
    }

    .campaign-date-range {
      gap: var(--space-3);
    }

    .campaign-participant {
      align-items: flex-start;
    }

    .campaign-card-actions > *,
    .campaign-edit-actions > .btn {
      flex: 1 1 100%;
    }
  }
</style>

<div class="page-heading">
  <h1 style="margin: 0;">Marketing Campaigns</h1>
  <a href="/admin" class="btn btn--ghost">← Back to Admin</a>
</div>

<div class="campaign-page">
  <section class="card">
    <h2 style="margin-top: 0;">Create New Campaign</h2>
    <form method="POST" action="/admin/campaigns">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
      <div class="campaign-create-fields">
        <div class="field">
          <label for="campaign-title">Campaign Title</label>
          <input id="campaign-title" type="text" name="title" required placeholder="e.g. HOSA Business Week 2026">
        </div>
        <div class="field">
          <label>Date Range</label>
          <div class="campaign-date-range">
            <input type="date" name="start_date" aria-label="Campaign start date" required>
            <input type="date" name="end_date" aria-label="Campaign end date" required>
          </div>
        </div>
      </div>
      <div class="field">
        <label for="campaign-description">Description</label>
        <textarea id="campaign-description" name="description" rows="2" required placeholder="Brief description of the campaign..."></textarea>
      </div>
      <button type="submit" class="btn btn--primary">Create Campaign</button>
    </form>
  </section>

  <section class="campaign-list">
    <div>
      <h2>Active & Upcoming Campaigns</h2>
      <% if (activeCampaigns.length === 0) { %>
        <p style="color: var(--muted); margin-bottom: 0;">No active campaigns.</p>
      <% } %>
    </div>

    <% activeCampaigns.forEach(c => { %>
      <article class="card campaign-card">
        <div class="campaign-card-header">
          <div>
            <h2 style="margin: 0;"><%= c.title %></h2>
            <p style="color: var(--muted); font-size: var(--text-sm); margin-bottom: 0;">
              <%= new Date(c.start_date).toLocaleDateString('en-GB') %> to <%= new Date(c.end_date).toLocaleDateString('en-GB') %>
            </p>
          </div>
          <span class="badge badge--success">Active</span>
        </div>
        <p><%= c.description %></p>

        <h3 style="font-size: var(--text-base); border-top: 1px solid var(--line); padding-top: var(--space-3);">Participating Businesses</h3>
        <% if (c.participating_businesses && c.participating_businesses.length > 0) { %>
          <ul class="campaign-participants">
            <% c.participating_businesses.forEach(pb => { %>
              <li class="campaign-participant">
                <strong><%= pb.name %></strong>
                <form method="POST" action="/admin/campaigns/toggle-business" style="margin: 0;">
                  <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
                  <input type="hidden" name="campaignId" value="<%= c.id %>">
                  <input type="hidden" name="businessId" value="<%= pb.id %>">
                  <input type="hidden" name="action" value="remove">
                  <button type="submit" class="btn btn--ghost btn--sm" style="color: var(--danger);">Remove</button>
                </form>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p style="color: var(--muted); font-size: var(--text-sm); margin-bottom: var(--space-3);">No businesses added yet.</p>
        <% } %>

        <form method="POST" action="/admin/campaigns/toggle-business" class="campaign-add-form">
          <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
          <input type="hidden" name="campaignId" value="<%= c.id %>">
          <input type="hidden" name="action" value="add">
          <select name="businessId" aria-label="Business to add to <%= c.title %>">
            <% businesses.forEach(b => { %><option value="<%= b.id %>"><%= b.name %></option><% }) %>
          </select>
          <button type="submit" class="btn btn--ghost btn--sm">Add Business</button>
        </form>

        <div class="campaign-card-actions">
          <button type="button" class="btn btn--ghost btn--sm" aria-controls="edit-form-<%= c.id %>" aria-expanded="false" onclick="const form = document.getElementById('edit-form-<%= c.id %>'); const isOpen = form.style.display !== 'none'; form.style.display = isOpen ? 'none' : 'block'; this.setAttribute('aria-expanded', String(!isOpen));">Edit Campaign</button>
          <form method="POST" action="/admin/campaigns/<%= c.id %>/delete" onsubmit="return confirm('Delete this campaign permanently?')" style="margin: 0;">
            <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
            <button type="submit" class="btn btn--ghost btn--sm" style="color: var(--danger);">Delete</button>
          </form>
        </div>

        <div id="edit-form-<%= c.id %>" class="campaign-edit-panel" style="display: none;">
          <h3 style="margin-top: 0;">Edit: <%= c.title %></h3>
          <form method="POST" action="/admin/campaigns/<%= c.id %>/update">
            <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
            <div class="campaign-edit-fields">
              <input type="text" name="title" aria-label="Campaign title" value="<%= c.title %>" required>
              <div class="campaign-edit-dates">
                <input type="date" name="start_date" aria-label="Campaign start date" value="<%= c.start_date.toISOString().split('T')[0] %>" required>
                <input type="date" name="end_date" aria-label="Campaign end date" value="<%= c.end_date.toISOString().split('T')[0] %>" required>
              </div>
            </div>
            <textarea name="description" aria-label="Campaign description" rows="2" required><%= c.description %></textarea>
            <div class="campaign-edit-actions">
              <button type="submit" class="btn btn--primary btn--sm">Save Changes</button>
              <button type="button" class="btn btn--ghost btn--sm" aria-controls="edit-form-<%= c.id %>" aria-expanded="true" onclick="const form = document.getElementById('edit-form-<%= c.id %>'); form.style.display = 'none'; form.previousElementSibling.querySelector('[aria-controls]').setAttribute('aria-expanded', 'false');">Cancel</button>
            </div>
          </form>
        </div>
      </article>
    <% }) %>
  </section>

  <section class="campaign-list">
    <div>
      <h2 style="color: var(--muted);">Past Campaigns</h2>
      <% if (pastCampaigns.length === 0) { %>
        <p style="color: var(--muted); margin-bottom: 0;">No past campaigns.</p>
      <% } %>
    </div>

    <% pastCampaigns.forEach(c => { %>
      <article class="card campaign-card" style="opacity: 0.7;">
        <div class="campaign-card-header">
          <div>
            <h2 style="margin: 0;"><%= c.title %></h2>
            <p style="color: var(--muted); font-size: var(--text-sm); margin-bottom: 0;">
              <%= new Date(c.start_date).toLocaleDateString('en-GB') %> to <%= new Date(c.end_date).toLocaleDateString('en-GB') %>
            </p>
          </div>
          <span class="badge badge--muted">Expired</span>
        </div>
        <p><%= c.description %></p>
        <form method="POST" action="/admin/campaigns/<%= c.id %>/delete" onsubmit="return confirm('Delete this campaign permanently?')" style="margin-top: var(--space-3);">
          <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
          <button type="submit" class="btn btn--ghost btn--sm" style="color: var(--danger);">Delete</button>
        </form>
      </article>
    <% }) %>
  </section>
</div>
