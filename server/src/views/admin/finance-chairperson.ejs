<div class="page-header">
  <div>
    <h1>Expense Approval Review</h1>
    <p class="text-muted">
      Review expense requests assigned to the Chairperson approval stage.
    </p>
  </div>

  <a href="/dashboard" class="btn btn--ghost">Back to Dashboard</a>
</div>

<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center; gap:var(--space-3); flex-wrap:wrap; margin-bottom:var(--space-4);">
    <div>
      <h2 style="margin:0;">Requests Awaiting Your Review</h2>
      <p style="color:var(--muted); margin:var(--space-1) 0 0;">
        Only requests that have reached the Chairperson approval stage are shown.
      </p>
    </div>

    <span class="badge badge--warning">
      <%= expenses.length %> Pending Review
    </span>
  </div>

  <% if (!expenses || expenses.length === 0) { %>
    <div style="padding:var(--space-5); text-align:center;">
      <h3>No expense requests awaiting review</h3>
      <p style="color:var(--muted);">
        There are currently no requests assigned to your approval stage.
      </p>
    </div>
  <% } else { %>

    <div style="display:grid; gap:var(--space-4);">
      <% expenses.forEach((expense) => { %>
        <article
          class="card"
          style="border:1px solid var(--line); box-shadow:none;"
        >
          <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:var(--space-3); flex-wrap:wrap;">
            <div>
              <h3 style="margin:0 0 var(--space-1);">
                <%= expense.title %>
              </h3>

              <p style="color:var(--muted); margin:0;">
                Submitted by:
                <strong>
                  <%= [expense.first_name, expense.last_name].filter(Boolean).join(" ") || "Member" %>
                </strong>
              </p>
            </div>

            <span class="badge badge--warning">
              Awaiting Chairperson
            </span>
          </div>

          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:var(--space-3); margin:var(--space-4) 0;">
            <div>
              <small style="color:var(--muted);">Amount Requested</small>
              <p style="font-weight:700; margin:4px 0;">
                UGX <%= Number(expense.amount).toLocaleString() %>
              </p>
            </div>

            <div>
              <small style="color:var(--muted);">Category</small>
              <p style="margin:4px 0;">
                <%= expense.category %>
              </p>
            </div>

            <div>
              <small style="color:var(--muted);">Submitting Office</small>
              <p style="margin:4px 0;">
                <%= expense.submitted_office || "Not specified" %>
              </p>
            </div>

            <div>
              <small style="color:var(--muted);">Date Submitted</small>
              <p style="margin:4px 0;">
                <%= expense.created_at ? new Date(expense.created_at).toLocaleDateString() : "—" %>
              </p>
            </div>
          </div>

          <% if (expense.description) { %>
            <div style="background:var(--ivory); padding:var(--space-3); border-radius:var(--radius-sm); margin-bottom:var(--space-4);">
              <strong>Description</strong>
              <p style="margin:var(--space-1) 0 0; white-space:pre-wrap;"><%= expense.description %></p>
            </div>
          <% } %>

          <div style="display:flex; gap:var(--space-2); flex-wrap:wrap;">
            <form
              method="post"
              action="/admin/finance/expenses/<%= expense.id %>/status"
              onsubmit="return confirm('Approve this expense request and forward it to the Super Admin?')"
            >
              <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
              <input type="hidden" name="status" value="approved">

              <button type="submit" class="btn btn--primary">
                Approve Request
              </button>
            </form>

            <button
              type="button"
              class="btn btn--ghost"
              style="color:var(--danger);"
              onclick="document.getElementById('chairperson-reject-<%= expense.id %>').style.display = document.getElementById('chairperson-reject-<%= expense.id %>').style.display === 'none' ? 'block' : 'none';"
            >
              Reject Request
            </button>
          </div>

          <div
            id="chairperson-reject-<%= expense.id %>"
            style="display:none; margin-top:var(--space-3); padding:var(--space-3); background:#fff5f5; border:1px solid var(--danger); border-radius:var(--radius-sm);"
          >
            <form
              method="post"
              action="/admin/finance/expenses/<%= expense.id %>/status"
            >
              <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
              <input type="hidden" name="status" value="rejected">

              <div class="field">
                <label for="reason-<%= expense.id %>">
                  Reason for rejection
                </label>

                <textarea
                  id="reason-<%= expense.id %>"
                  name="reason"
                  rows="3"
                  minlength="5"
                  maxlength="500"
                  required
                  placeholder="Explain why this expense request is being rejected."
                ></textarea>
              </div>

              <button type="submit" class="btn btn--ghost" style="color:var(--danger);">
                Confirm Rejection
              </button>
            </form>
          </div>
        </article>
      <% }); %>
    </div>
  <% } %>
</div>