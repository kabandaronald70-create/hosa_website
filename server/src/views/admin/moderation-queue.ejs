<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-5); flex-wrap: wrap; gap: var(--space-3);">
  <h1 style="margin: 0;">Moderation queue</h1>
  <a href="/admin" class="btn btn--ghost">← Back to admin</a>
</div>

<section style="margin-bottom: var(--space-6);">
  <h2 style="font-size: var(--text-xl); border-bottom: 2px solid var(--line); padding-bottom: var(--space-2); margin-bottom: var(--space-4);">
    Pending Stories (<%= stories.total %>)
  </h2>

  <% if (stories.rows.length === 0) { %>
    <div class="empty-state" style="padding: var(--space-5);">
      <p style="margin: 0; color: var(--muted);">No stories waiting for review.</p>
    </div>
  <% } else { %>
    <% stories.rows.forEach((s) => { %>
      <article class="card" style="margin-bottom: var(--space-4);">
        <h3 style="margin-top: 0; margin-bottom: var(--space-2);"><%= s.title %></h3>
        <p style="color: var(--muted); font-size: var(--text-sm); margin-bottom: var(--space-3);">
          By <strong><%= s.author_name || '—' %></strong>
          <% if (s.class_year) { %> · Class of <%= s.class_year %><% } %>
          <% if (s.category) { %> · <%= s.category %><% } %>
          · Submitted <%= new Date(s.created_at).toLocaleDateString('en-GB') %>
        </p>
        
        <% if (s.excerpt) { %>
          <p style="font-style: italic; border-left: 3px solid var(--line); padding-left: var(--space-3); margin-bottom: var(--space-4);"><%= s.excerpt %></p>
        <% } %>

        <details style="margin-bottom: var(--space-4);">
          <summary style="cursor: pointer; font-weight: 600; color: var(--green);">Read full body</summary>
          <p style="margin-top: var(--space-2); white-space: pre-wrap; font-size: var(--text-sm);"><%= s.body %></p>
        </details>

        <div style="display: flex; gap: var(--space-3); align-items: flex-end; flex-wrap: wrap;">
          <form method="post" action="/admin/moderation/stories/<%= s.id %>/approve" style="margin: 0;">
            <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
            <button type="submit" class="btn btn--primary">Approve & Publish</button>
          </form>
          
          <form method="post" action="/admin/moderation/stories/<%= s.id %>/reject" style="margin: 0; display: flex; gap: var(--space-2); align-items: flex-end;">
            <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
            <div class="field" style="margin: 0;">
              <input id="story-reason-<%= s.id %>" name="reason" type="text" maxlength="500" placeholder="Rejection reason" required style="min-height: 36px; padding: var(--space-1) var(--space-2);">
            </div>
            <button type="submit" class="btn btn--danger" style="height: 36px;">Reject</button>
          </form>
        </div>
      </article>
    <% }) %>
  <% } %>
</section>

<section>
  <h2 style="font-size: var(--text-xl); border-bottom: 2px solid var(--line); padding-bottom: var(--space-2); margin-bottom: var(--space-4);">
    Pending Opportunities (<%= opportunities.total %>)
  </h2>

  <% if (opportunities.rows.length === 0) { %>
    <div class="empty-state" style="padding: var(--space-5);">
      <p style="margin: 0; color: var(--muted);">No opportunities waiting for review.</p>
    </div>
  <% } else { %>
    <% opportunities.rows.forEach((o) => { %>
      <article class="card" style="margin-bottom: var(--space-4);">
        <h3 style="margin-top: 0; margin-bottom: var(--space-2);"><%= o.title %></h3>
        <p style="color: var(--muted); font-size: var(--text-sm); margin-bottom: var(--space-3);">
          <%= o.employer || o.organization || '—' %>
          <% if (o.location) { %> · <%= o.location %><% } %>
          <% if (o.type_label) { %> · <%= o.type_label %><% } %>
          <% if (o.deadline) { %> · Deadline: <%= new Date(o.deadline).toLocaleDateString('en-GB') %><% } %>
        </p>
        
        <p style="font-size: var(--text-sm);"><%= o.description %></p>

        <div style="display: flex; gap: var(--space-3); align-items: flex-end; flex-wrap: wrap; margin-top: var(--space-4);">
          <form method="post" action="/admin/moderation/opportunities/<%= o.id %>/approve" style="margin: 0;">
            <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
            <button type="submit" class="btn btn--primary">Approve</button>
          </form>
          
          <form method="post" action="/admin/moderation/opportunities/<%= o.id %>/reject" style="margin: 0; display: flex; gap: var(--space-2); align-items: flex-end;">
            <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
            <div class="field" style="margin: 0;">
              <input id="opp-reason-<%= o.id %>" name="reason" type="text" maxlength="500" placeholder="Rejection reason" required style="min-height: 36px; padding: var(--space-1) var(--space-2);">
            </div>
            <button type="submit" class="btn btn--danger" style="height: 36px;">Reject</button>
          </form>
        </div>
      </article>
    <% }) %>
  <% } %>
</section>