<div
  style="
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
    gap: var(--space-3);
  "
>
  <h1 style="margin: 0">Audit Entry #<%= entry.id %></h1>
  <a href="/admin/audit" class="btn btn--ghost">← Back to log</a>
</div>

<div class="card" style="max-width: 700px">
  <p>
    <strong>Action:</strong>
    <span class="badge badge--muted"><%= entry.action %></span>
  </p>
  <p>
    <strong>When:</strong> <%= new
    Date(entry.occurred_at).toLocaleString('en-GB') %>
  </p>
  <p><strong>Actor:</strong> <%= entry.actor_email || '—' %></p>
  <p>
    <strong>Target:</strong> <%= entry.target_type || '—' %> (<%=
    entry.target_id || '—' %>)
  </p>
  <p><strong>IP Address:</strong> <%= entry.ip_address || '—' %></p>

  <hr
    style="
      border: 0;
      border-top: 1px solid var(--line);
      margin: var(--space-4) 0;
    "
  />

  <h3 style="margin-top: 0">Metadata</h3>
  <pre
    style="
      background: var(--ivory);
      padding: var(--space-3);
      border-radius: var(--radius-sm);
      font-size: var(--text-sm);
      overflow-x: auto;
    "
  >
<%= JSON.stringify(entry.metadata, null, 2) %></pre
  >
</div>
