<h1>Members</h1>

<form method="get" action="/admin/members">
  <fieldset>
    <legend>Filter</legend>

    <label for="q">Search</label>
    <input id="q" name="q" type="search" value="<%= filters.q %>" placeholder="email or name">

    <label for="status">Status</label>
    <select id="status" name="status">
      <option value=""       <%= !filters.status ? 'selected' : '' %>>Any</option>
      <option value="active"      <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
      <option value="suspended"   <%= filters.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
      <option value="deactivated" <%= filters.status === 'deactivated' ? 'selected' : '' %>>Deactivated</option>
    </select>

    <label for="role">Role</label>
    <select id="role" name="role">
      <option value=""           <%= !filters.role ? 'selected' : '' %>>Any</option>
      <option value="member"     <%= filters.role === 'member' ? 'selected' : '' %>>Member</option>
      <option value="mentor"     <%= filters.role === 'mentor' ? 'selected' : '' %>>Mentor</option>
      <option value="moderator"  <%= filters.role === 'moderator' ? 'selected' : '' %>>Moderator</option>
      <option value="admin"      <%= filters.role === 'admin' ? 'selected' : '' %>>Admin</option>
    </select>

    <label for="verified">Verified</label>
    <select id="verified" name="verified">
      <option value=""    <%= !filters.verified ? 'selected' : '' %>>Any</option>
      <option value="yes" <%= filters.verified === 'yes' ? 'selected' : '' %>>Verified</option>
      <option value="no"  <%= filters.verified === 'no'  ? 'selected' : '' %>>Not verified</option>
    </select>

    <p><button type="submit">Apply filters</button>
       <a href="/admin/members">Reset</a></p>
  </fieldset>
</form>

<p><%= result.total %> member<%= result.total === 1 ? '' : 's' %> — page <%= result.page %> of <%= result.pages %>.</p>

<table>
  <thead>
    <tr>
      <th>Email</th>
      <th>Name</th>
      <th>Class</th>
      <th>Status</th>
      <th>Roles</th>
      <th>Verified</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% result.rows.forEach((m) => { %>
      <tr>
        <td><%= m.email %></td>
        <td><%= m.display_name || `${m.first_name} ${m.last_name}` %></td>
        <td><%= m.graduation_year ?? '—' %></td>
        <td><%= m.status %></td>
        <td><%= m.roles.join(', ') || '—' %></td>
        <td><%= m.verified_at ? '✓' : '—' %></td>
        <td><a href="/admin/members/<%= m.id %>">Open</a></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<% if (result.pages > 1) { %>
  <nav aria-label="Pagination">
    <% if (result.page > 1) { %>
      <a href="?<%= new URLSearchParams({ ...filters, page: String(result.page - 1) }).toString() %>">← Previous</a>
    <% } %>
    <% if (result.page < result.pages) { %>
      <a href="?<%= new URLSearchParams({ ...filters, page: String(result.page + 1) }).toString() %>">Next →</a>
    <% } %>
  </nav>
<% } %>