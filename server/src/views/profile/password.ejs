<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-5); flex-wrap: wrap; gap: var(--space-3);">
  <h1 style="margin: 0;">Change password</h1>
  <a href="/dashboard" class="btn btn--ghost">← Back to dashboard</a>
</div>

<div style="max-width: 600px;">
  <% if (Object.keys(fieldErrors).length > 0) { %>
    <div class="alert alert--error" role="alert">
      <ul style="margin: 0; padding-left: var(--space-4);">
        <% Object.entries(fieldErrors).forEach(([k, msg]) => { %>
          <li><%= k.replace(/_/g, ' ') %>: <%= msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <div class="card">
    <form method="post" action="/dashboard/password" novalidate>
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">

      <div class="field">
        <label for="current_password">Current password</label>
        <input id="current_password" name="current_password" type="password" autocomplete="current-password" required>
        <% if (fieldErrors.current_password) { %><span class="field-error"><%= fieldErrors.current_password %></span><% } %>
      </div>

      <hr style="border: 0; border-top: 1px solid var(--line); margin: var(--space-5) 0;">

      <div class="field">
        <label for="new_password">New password</label>
        <input id="new_password" name="new_password" type="password" autocomplete="new-password" required minlength="10" maxlength="200">
        <span class="field-hint">At least 10 characters.</span>
        <% if (fieldErrors.new_password) { %><span class="field-error"><%= fieldErrors.new_password %></span><% } %>
      </div>

      <div class="field">
        <label for="confirm_new_password">Confirm new password</label>
        <input id="confirm_new_password" name="confirm_new_password" type="password" autocomplete="new-password" required minlength="10" maxlength="200">
        <% if (fieldErrors.confirm_new_password) { %><span class="field-error"><%= fieldErrors.confirm_new_password %></span><% } %>
      </div>

      <div style="margin-top: var(--space-6);">
        <button type="submit" class="btn btn--primary" style="width: 100%;">Change password</button>
      </div>
    </form>
  </div>

  <p style="font-size: var(--text-sm); color: var(--muted); margin-top: var(--space-4);">
    <strong>Note:</strong> Changing your password will sign you out of other devices for security reasons.
  </p>
</div>