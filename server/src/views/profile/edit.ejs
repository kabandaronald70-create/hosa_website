<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-5); flex-wrap: wrap; gap: var(--space-3);">
  <h1 style="margin: 0;">Edit profile</h1>
  <a href="/dashboard" class="btn btn--ghost">← Back to dashboard</a>
</div>

<% if (Object.keys(fieldErrors).length > 0) { %>
  <div class="alert alert--error" role="alert">
    <strong>Please fix the following:</strong>
    <ul style="margin: var(--space-2) 0 0 var(--space-4); padding: 0;">
      <% Object.entries(fieldErrors).forEach(([k, msg]) => { %>
        <li><%= k.replace(/_/g, ' ') %>: <%= msg %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<div style="max-width: 800px;">

  <!-- Avatar Section (Separate Form) -->
  <div class="card" style="margin-bottom: var(--space-5);">
    <h2 style="font-size: var(--text-lg); margin-top: 0;">Profile photo</h2>
    
    <div style="display: flex; align-items: center; gap: var(--space-4); margin-bottom: var(--space-4);">
      <% if (values.avatar_path) { %>
        <img src="/dashboard/avatar/me" alt="Your current profile photo" style="width: 96px; height: 96px; border-radius: 50%; object-fit: cover; border: 2px solid var(--line);">
      <% } else { %>
        <div style="width: 96px; height: 96px; border-radius: 50%; background: var(--gold); color: var(--ink); display: grid; place-items: center; font-size: var(--text-2xl); font-weight: 700;">?</div>
      <% } %>
      
      <form id="avatar-form" method="post" action="/dashboard/avatar" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: var(--space-2);">
        <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
        <p style="margin: 0; font-size: var(--text-sm); color: var(--muted);">Max 2MB. JPEG, PNG, or WebP.</p>
        <div style="display: flex; gap: var(--space-2);">
          <input type="file" name="avatar" accept="image/jpeg,image/png,image/webp" required style="font-size: var(--text-sm);">
          <button type="submit" class="btn btn--primary btn--sm">Upload</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Main Profile Form -->
  <form method="post" action="/dashboard/profile" novalidate>
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">

    <div class="card" style="margin-bottom: var(--space-5);">
      <h2 style="font-size: var(--text-lg); margin-top: 0;">Basic details</h2>
      
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
        <div class="field">
          <label for="first_name">First name</label>
          <input id="first_name" name="first_name" type="text" required maxlength="80" value="<%= values.first_name || '' %>">
          <% if (fieldErrors.first_name) { %><span class="field-error"><%= fieldErrors.first_name %></span><% } %>
        </div>
        <div class="field">
          <label for="last_name">Last name</label>
          <input id="last_name" name="last_name" type="text" required maxlength="80" value="<%= values.last_name || '' %>">
          <% if (fieldErrors.last_name) { %><span class="field-error"><%= fieldErrors.last_name %></span><% } %>
        </div>
      </div>

      <div class="field">
        <label for="display_name">Display name (optional)</label>
        <input id="display_name" name="display_name" type="text" maxlength="120" value="<%= values.display_name || '' %>">
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
        <div class="field">
          <label for="graduation_year">Graduation year</label>
          <input id="graduation_year" name="graduation_year" type="number" min="1950" max="2100" value="<%= values.graduation_year || '' %>">
          <% if (fieldErrors.graduation_year) { %><span class="field-error"><%= fieldErrors.graduation_year %></span><% } %>
        </div>
        <div class="field">
          <label for="profession">Profession</label>
          <input id="profession" name="profession" type="text" maxlength="120" value="<%= values.profession || '' %>">
        </div>
      </div>

      <div class="field">
        <label for="organization">Organization</label>
        <input id="organization" name="organization" type="text" maxlength="120" value="<%= values.organization || '' %>">
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
        <div class="field">
          <label for="district">District</label>
          <input id="district" name="district" type="text" maxlength="120" value="<%= values.district || '' %>">
        </div>
        <div class="field">
          <label for="country_code">Country code (e.g. UG)</label>
          <input id="country_code" name="country_code" type="text" maxlength="2" value="<%= values.country_code || '' %>">
        </div>
      </div>
    </div>

    <div class="card" style="margin-bottom: var(--space-5);">
      <h2 style="font-size: var(--text-lg); margin-top: 0;">About you</h2>
      
      <div class="field">
        <label for="biography">Biography</label>
        <textarea id="biography" name="biography" rows="4" maxlength="2000"><%= values.biography || '' %></textarea>
      </div>
      
      <div class="field">
        <label for="skills">Skills</label>
        <textarea id="skills" name="skills" rows="2" maxlength="500"><%= values.skills || '' %></textarea>
      </div>
      
      <div class="field">
        <label for="career_history">Career History</label>
        <textarea id="career_history" name="career_history" rows="4" maxlength="4000"><%= values.career_history || '' %></textarea>
      </div>
    </div>

      <div class="card" style="margin-bottom: var(--space-5);">
    <h2 style="font-size: var(--text-lg); margin-top: 0;">Privacy & Mentorship</h2>
    
    <div class="field" style="flex-direction: row; align-items: center; gap: var(--space-2); margin-bottom: var(--space-4);">
      <input type="checkbox" id="mentor_opt_in" name="mentor_opt_in" value="on" <%= values.mentor_opt_in ? 'checked' : '' %> style="min-height: auto;">
      <label for="mentor_opt_in" style="margin: 0; font-weight: normal;">I am willing to mentor current students</label>
    </div>

    <div class="field" style="flex-direction: row; align-items: center; gap: var(--space-2); margin-bottom: var(--space-4);">
      <input type="checkbox" id="public_visibility" name="public_visibility" value="on" <%= values.public_visibility !== false ? 'checked' : '' %> style="min-height: auto;">
      <label for="public_visibility" style="margin: 0; font-weight: normal;">Show my profile in the public directory</label>
    </div>

    <h3 style="font-size: var(--text-base); margin-top: var(--space-4); margin-bottom: var(--space-2);">Contact Visibility</h3>
    
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
      <div class="field">
        <label for="email_privacy">Email Address</label>
        <select id="email_privacy" name="email_privacy">
          <option value="public" <%= values.email_privacy === 'public' ? 'selected' : '' %>>Public</option>
          <option value="members" <%= values.email_privacy === 'members' ? 'selected' : '' %>>Members Only</option>
          <option value="private" <%= values.email_privacy === 'private' ? 'selected' : '' %>>Only Me (Private)</option>
        </select>
      </div>

      <div class="field">
        <label for="phone_privacy">Phone Number</label>
        <select id="phone_privacy" name="phone_privacy">
          <option value="public" <%= values.phone_privacy === 'public' ? 'selected' : '' %>>Public</option>
          <option value="members" <%= values.phone_privacy === 'members' ? 'selected' : '' %>>Members Only</option>
          <option value="private" <%= values.phone_privacy === 'private' ? 'selected' : '' %>>Only Me (Private)</option>
        </select>
      </div>
    </div>

    <div class="field">
      <label for="district_privacy">District / Location</label>
      <select id="district_privacy" name="district_privacy">
        <option value="public" <%= values.district_privacy === 'public' ? 'selected' : '' %>>Public</option>
        <option value="members" <%= values.district_privacy === 'members' ? 'selected' : '' %>>Members Only</option>
        <option value="private" <%= values.district_privacy === 'private' ? 'selected' : '' %>>Only Me (Private)</option>
      </select>
    </div>
  </div>
    <button type="submit" class="btn btn--primary" style="width: 100%; padding: var(--space-3); font-size: var(--text-lg); margin-bottom: var(--space-6);">Save profile</button>
  </form>

  <!-- Remove Avatar (if it exists) -->
  <% if (values.avatar_path) { %>
    <form method="post" action="/dashboard/avatar/delete" style="margin-bottom: var(--space-6);">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
      <button type="submit" class="btn btn--ghost" style="color: var(--danger); border-color: var(--danger); width: 100%;" onclick="return confirm('Remove your profile photo?')">Remove current profile photo</button>
    </form>
  <% } %>

  <!-- Danger Zone -->
  <div class="card" style="border-color: var(--danger); background: #fffaf9; margin-bottom: var(--space-6);">
    <h2 style="font-size: var(--text-lg); margin-top: 0; color: var(--danger);">Danger Zone</h2>
    
    <div style="margin-bottom: var(--space-5);">
      <p style="font-size: var(--text-sm); color: var(--muted); margin-bottom: var(--space-2);">Download a copy of your data in JSON format.</p>
      <a href="/dashboard/export-data" class="btn btn--ghost">Download My Data</a>
    </div>

    <div>
      <p style="font-size: var(--text-sm); color: var(--muted); margin-bottom: var(--space-2);">Once you delete your account, there is no going back. All your data will be erased.</p>
      
      <button type="button" class="btn btn--danger" onclick="document.getElementById('delete-account-form').style.display='block'; this.style.display='none';">Delete My Account</button>
      
      <div id="delete-account-form" style="display: none; margin-top: var(--space-3); padding: var(--space-4); background: var(--white); border: 1px solid var(--danger); border-radius: var(--radius-sm);">
        <form method="post" action="/dashboard/delete-account">
          <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
          <div class="field">
            <label for="delete_password">Confirm your password to delete</label>
            <input id="delete_password" name="password" type="password" required>
          </div>
          <button type="submit" class="btn btn--danger" style="width: 100%;">Permanently Delete Account</button>
        </form>
      </div>
    </div>
  </div>

</div>