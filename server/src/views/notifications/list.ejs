<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-5); flex-wrap: wrap; gap: var(--space-3);">
  <h1 style="margin: 0;">Notifications</h1>
  <a href="/dashboard" class="btn btn--ghost">← Back to dashboard</a>
</div>

<div style="max-width: 800px;">
  <% if (unread > 0) { %>
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
      <p style="margin: 0; color: var(--muted);">You have <strong><%= unread %></strong> unread notification<%= unread === 1 ? '' : 's' %>.</p>
      <form method="post" action="/notifications/read-all" style="margin: 0;">
        <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
        <button type="submit" class="btn btn--ghost btn--sm">Mark all as read</button>
      </form>
    </div>
  <% } %>

  <% if (items.length === 0) { %>
    <div class="empty-state" style="padding: var(--space-8) var(--space-4); background: var(--white);">
      <div style="font-size: 48px; margin-bottom: var(--space-3);">📭</div>
      <h2 style="margin: 0 0 var(--space-2); font-size: var(--text-xl);">You're all caught up</h2>
      <p style="margin: 0; color: var(--muted);">No notifications yet. We'll let you know when something happens.</p>
    </div>
  <% } else { %>
    <div style="display: flex; flex-direction: column; gap: var(--space-3);">
      <% items.forEach((n) => { %>
        <article class="card" style="<%= n.read_at ? 'opacity: 0.7;' : 'border-left: 4px solid var(--gold);' %>">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-3); flex-wrap: wrap;">
            <div>
              <h3 style="margin: 0 0 var(--space-1); font-size: var(--text-lg);"><%= n.title %></h3>
              <p style="margin: 0; font-size: var(--text-sm); color: var(--muted);">
                <%= new Date(n.created_at).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) %>
              </p>
            </div>
            
            <% if (!n.read_at) { %>
              <form method="post" action="/notifications/<%= n.id %>/read" style="margin: 0;">
                <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
                <button type="submit" class="btn btn--ghost btn--sm">Mark read</button>
              </form>
            <% } %>
          </div>
          
          <% if (n.body) { %>
            <p style="margin: var(--space-3) 0 0; font-size: var(--text-sm);"><%= n.body %></p>
          <% } %>
          
          <% if (n.link) { %>
            <div style="margin-top: var(--space-3);">
              <a href="<%= n.link %>" class="btn btn--primary btn--sm">View Details</a>
            </div>
          <% } %>
        </article>
      <% }) %>
    </div>
  <% } %>
</div>