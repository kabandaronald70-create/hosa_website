<h1>Dashboard</h1>

<p>
  Welcome,
  <strong
    ><%= currentProfile?.display_name || currentProfile?.first_name ||
    currentUser.email %></strong
  >.
</p>

<dl>
  <dt>Email</dt>
  <dd><%= currentUser.email %></dd>

  <dt>Roles</dt>
  <dd><%= currentUserRoles.join(', ') || '(none)' %></dd>

  <dt>Account status</dt>
  <dd><%= currentUser.status %></dd>

  <dt>Member since</dt>
  <dd><%= new Date(currentUser.created_at).toLocaleString() %></dd>
</dl>

<form method="post" action="/logout">
  <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>" />
  <button type="submit">Log out</button>
</form>

<p><a href="/">Back to home</a></p>
