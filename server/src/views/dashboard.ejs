<h1>Alumni Dashboard</h1>

<!-- Profile Summary Card -->
<div class="card" style="display: flex; align-items: center; gap: var(--space-4); margin-bottom: var(--space-6);">
  <% if (currentProfile && currentProfile.avatar_path) { %>
    <img src="/dashboard/avatar/me" alt="" style="width: 72px; height: 72px; border-radius: 50%; object-fit: cover;">
  <% } else { %>
    <div style="width: 72px; height: 72px; border-radius: 50%; background: var(--gold); color: var(--ink); display: grid; place-items: center; font-size: var(--text-2xl); font-weight: 700;">
      <%= (currentProfile?.first_name || currentUser.email)[0].toUpperCase() %>
    </div>
  <% } %>
  <div>
    <h2 style="margin: 0 0 var(--space-1);">Welcome, <%= currentProfile?.display_name || currentProfile?.first_name || currentUser.email %></h2>
    <p style="color: var(--muted); margin: 0;">
      Class of <%= currentProfile?.graduation_year || '—' %> · <%= currentProfile?.profession || 'Update your profession' %>
    </p>
  </div>
</div>

<!-- HOSA Financial Status Card -->
<% if (typeof finance !== 'undefined' && finance) { %>
  <section class="card" style="margin-bottom: var(--space-6); border-left: 4px solid var(--green); background: var(--ivory);">
    <h2 style="font-size: var(--text-lg); margin-top: 0; color: var(--green);">HOSA Financial Status</h2>
    <p style="font-size: var(--text-sm); color: var(--muted); margin-bottom: var(--space-4);">
      In the spirit of transparency, here is a summary of the Association's current financial position.
    </p>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap: var(--space-4);">
      <div style="background: var(--white); padding: var(--space-3); border-radius: var(--radius-sm); border: 1px solid var(--line);">
        <p style="font-size: var(--text-xs); color: var(--muted); margin: 0; text-transform: uppercase; letter-spacing: 0.5px;">Verified Income</p>
        <p style="font-size: var(--text-lg); font-weight: bold; color: var(--success); margin: var(--space-1) 0 0;">
          UGX <%= finance.totalIncome.toLocaleString() %>
        </p>
      </div>
      
      <div style="background: var(--white); padding: var(--space-3); border-radius: var(--radius-sm); border: 1px solid var(--line);">
        <p style="font-size: var(--text-xs); color: var(--muted); margin: 0; text-transform: uppercase; letter-spacing: 0.5px;">Total Expenses</p>
        <p style="font-size: var(--text-lg); font-weight: bold; color: var(--danger); margin: var(--space-1) 0 0;">
          UGX <%= finance.totalExpenses.toLocaleString() %>
        </p>
      </div>
      
      <div style="background: var(--white); padding: var(--space-3); border-radius: var(--radius-sm); border: 2px solid var(--green);">
        <p style="font-size: var(--text-xs); color: var(--muted); margin: 0; text-transform: uppercase; letter-spacing: 0.5px;">Net Balance</p>
        <p style="font-size: var(--text-lg); font-weight: bold; color: var(--green); margin: var(--space-1) 0 0;">
          UGX <%= finance.netBalance.toLocaleString() %>
        </p>
      </div>
    </div>
    
    <div style="margin-top: var(--space-4); text-align: right;">
      <a href="/dashboard/contributions" class="btn btn--ghost btn--sm">Make a Contribution →</a>
    </div>
  </section>
<% } %>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: var(--space-5); margin-bottom: var(--space-6);">
  <!-- Profile Completion -->
  <section class="card">
    <h2 style="font-size: var(--text-lg); margin-top: 0;">Profile Completion</h2>
    <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3);">
      <div style="font-size: var(--text-2xl); font-weight: 700; color: var(--green);"><%= completion.pct %>%</div>
      <div style="flex-grow: 1; background: var(--line); height: 8px; border-radius: 4px; overflow: hidden;">
        <div style="background: var(--success); height: 100%; width: <%= completion.pct %>%;"></div>
      </div>
    </div>
    <% if (completion.missing.length > 0) { %>
      <p style="font-size: var(--text-sm); color: var(--muted); margin-bottom: var(--space-3);">Missing: <%= completion.missing.join(', ') %></p>
      <a href="/dashboard/profile" class="btn btn--ghost">Complete Profile</a>
    <% } else { %>
      <p style="font-size: var(--text-sm); color: var(--success);">Your profile looks complete! 🎉</p>
    <% } %>
  </section>

  <!-- Account Status -->
  <section class="card">
    <h2 style="font-size: var(--text-lg); margin-top: 0;">Account</h2>
    <p style="font-size: var(--text-sm); margin-bottom: var(--space-1);"><strong>Email:</strong> <%= currentUser.email %></p>
    <p style="font-size: var(--text-sm); margin-bottom: var(--space-1);"><strong>Roles:</strong> <%= currentUserRoles.join(', ') %></p>
    <p style="font-size: var(--text-sm); margin-bottom: var(--space-3);"><strong>Status:</strong> 
      <% if (currentUser.status === 'active') { %><span class="badge badge--success">Active</span><% } else { %><span class="badge badge--warning"><%= currentUser.status %></span><% } %>
    </p>
    <a href="/dashboard/password" class="btn btn--ghost">Change Password</a>
  </section>
</div>

<!-- Contribute Section -->
<section style="margin-bottom: var(--space-6);">
  <h2>Contribute to HOSA</h2>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: var(--space-4); margin-top: var(--space-4);">
    <a href="/dashboard/stories/new" class="card" style="text-decoration: none; color: inherit; text-align: center; padding: var(--space-4);">
      <div style="font-size: var(--text-2xl); margin-bottom: var(--space-2);">📝</div>
      <strong>Submit a Story</strong>
    </a>
    <a href="/dashboard/opportunities/new" class="card" style="text-decoration: none; color: inherit; text-align: center; padding: var(--space-4);">
      <div style="font-size: var(--text-2xl); margin-bottom: var(--space-2);">💼</div>
      <strong>Post a Job / Internship</strong>
    </a>
    <a href="/dashboard/submissions" class="card" style="text-decoration: none; color: inherit; text-align: center; padding: var(--space-4);">
      <div style="font-size: var(--text-2xl); margin-bottom: var(--space-2);">📂</div>
      <strong>My Submissions</strong>
    </a>
  </div>
</section>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: var(--space-5);">
  <!-- Upcoming RSVPs -->
  <section class="card">
    <h2 style="font-size: var(--text-lg); margin-top: 0;">My Upcoming RSVPs</h2>
    <% if (!rsvps || rsvps.length === 0) { %>
      <p style="color: var(--muted); font-size: var(--text-sm);">You have no upcoming events. <a href="/events">Browse events</a>.</p>
    <% } else { %>
      <ul style="padding-left: var(--space-4); font-size: var(--text-sm); margin: 0;">
        <% rsvps.forEach((r) => { %>
          <li style="margin-bottom: var(--space-2);">
            <strong><%= r.title %></strong><br>
            <span style="color: var(--muted);"><%= new Date(r.starts_at).toLocaleDateString('en-GB') %> · <%= r.status %></span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <!-- Mentorship -->
  <section class="card">
    <h2 style="font-size: var(--text-lg); margin-top: 0;">Mentorship</h2>
    <% if (activeMentorship > 0) { %>
      <p style="font-size: var(--text-sm);">You have <strong><%= activeMentorship %></strong> active mentorship request(s).</p>
      <a href="/dashboard/mentorship/requests" class="btn btn--primary">View Requests</a>
    <% } else { %>
      <p style="color: var(--muted); font-size: var(--text-sm);">You have no active mentorship requests.</p>
      <a href="/directory" class="btn btn--ghost">Find a Mentor</a>
    <% } %>
  </section>
</div>

<!-- Saved Items shortcut -->
<section style="margin-top: var(--space-6); text-align: center;">
  <a href="/dashboard/saved" class="btn btn--accent">View My Saved Items ⭐</a>
</section>