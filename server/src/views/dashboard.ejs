<h1>Dashboard</h1>

<p class="dashboard-greeting">
  <% if (currentProfile && currentProfile.avatar_path) { %>
    <img
      src="/dashboard/avatar/me?v=<%= currentProfile.updated_at ? new Date(currentProfile.updated_at).getTime() : Date.now() %>"
      alt=""
      width="64"
      height="64"
      class="dashboard-greeting__avatar">
  <% } %>
  <span class="dashboard-greeting__text">
    Welcome,
    <strong><%= currentProfile?.display_name || currentProfile?.first_name || currentUser.email %></strong>.
  </span>
</p>

<section aria-labelledby="completion-heading">
  <h2 id="completion-heading">Profile completion</h2>
  <p><strong><%= completion.pct %>%</strong> complete.</p>
  <% if (completion.missing.length > 0) { %>
    <p>Still missing:
      <em><%= completion.missing.map(s => s.replace(/_/g, ' ')).join(', ') %></em>
    </p>
  <% } else { %>
    <p>Your profile looks complete. 🎉</p>
  <% } %>
</section>

<section aria-labelledby="contribute-heading">
  <h2 id="contribute-heading">Contribute</h2>
  <ul>
    <li><a href="/dashboard/stories/new">Submit an alumni story</a></li>
    <li><a href="/dashboard/opportunities/new">Post a job, internship, or scholarship</a></li>
    <li><a href="/dashboard/submissions">View my submissions</a></li>
  </ul>
</section>

<% if (typeof rsvps !== 'undefined' && rsvps.length > 0) { %>
  <section aria-labelledby="rsvps-heading">
    <h2 id="rsvps-heading">My upcoming RSVPs</h2>
    <ul>
      <% rsvps.forEach((r) => { %>
        <li>
          <strong><%= r.title %></strong>
          — <%= new Date(r.starts_at).toLocaleDateString() %>
          at <%= r.venue || '—' %>
          <em>(<%= r.status %>)</em>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>

<% if (typeof activeMentorship !== 'undefined' && activeMentorship > 0) { %>
  <section aria-labelledby="mentorship-heading">
    <h2 id="mentorship-heading">Mentorship</h2>
    <p>
      You have <strong><%= activeMentorship %></strong> active mentorship
      request<%= activeMentorship === 1 ? '' : 's' %>.
      <a href="/dashboard/mentorship/requests">View them →</a>
    </p>
  </section>
<% } %>

<section aria-labelledby="saved-heading">
  <h2 id="saved-heading">Saved items</h2>
  <p><a href="/dashboard/saved">View my saved items →</a></p>
</section>

<section aria-labelledby="account-heading">
  <h2 id="account-heading">Account</h2>
  <dl>
    <dt>Email</dt>
    <dd><%= currentUser.email %></dd>

    <dt>Roles</dt>
    <dd><%= currentUserRoles.join(', ') || '(none)' %></dd>

    <dt>Status</dt>
    <dd><%= currentUser.status %></dd>

    <dt>Member since</dt>
    <dd><%= new Date(currentUser.created_at).toLocaleString() %></dd>
  </dl>
</section>

<section aria-labelledby="actions-heading">
  <h2 id="actions-heading">Actions</h2>
  <ul>
    <li><a href="/dashboard/profile">Edit profile</a></li>
    <li><a href="/dashboard/password">Change password</a></li>
  </ul>
</section>