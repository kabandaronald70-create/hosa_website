<h1>Dashboard</h1>

<p>
  Welcome,
  <strong><%= currentProfile?.display_name || currentProfile?.first_name || currentUser.email %></strong>.
</p>

<dl>
  <dt>Email</dt>
  <dd><%= currentUser.email %></dd>

  <dt>Roles</dt>
  <dd><%= currentUserRoles.join(', ') || '(none)' %></dd>

  <dt>Account status</dt>
  <dd><%= currentUser.status %></dd>

  <dt>Member since</dt>
  <dd><%= new Date(currentUser.created_at).toLocaleString() %></dd>

  <% if (currentProfile) { %>
    <dt>Graduation year</dt>
    <dd><%= currentProfile.graduation_year ?? '—' %></dd>

    <dt>District</dt>
    <dd><%= currentProfile.district || '—' %></dd>

    <dt>Mentor opt-in</dt>
    <dd><%= currentProfile.mentor_opt_in ? 'Yes' : 'No' %></dd>
  <% } %>
</dl>

<p>Phase 3 will add profile editing, avatar upload, and saved items here.</p>