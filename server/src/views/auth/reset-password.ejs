<div class="auth-layout">
  <div class="auth-layout__panel">
    <div class="auth-layout__brand">
      <h1 class="auth-layout__title">Set a new password.</h1>
      <p class="auth-layout__lede">
        Choose a strong password with at least 10 characters.
      </p>
    </div>
  </div>

  <div class="auth-layout__form">
    <h2>New password</h2>

    <% if (Object.keys(fieldErrors).length > 0) { %>
      <div class="alert alert--error" role="alert">
        <ul style="margin: var(--space-2) 0 0 var(--space-4); padding: 0;">
          <% Object.entries(fieldErrors).forEach(([k, msg]) => { %>
            <li><%= msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form method="post" action="/reset-password" novalidate>
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
      <input type="hidden" name="token" value="<%= token %>">

      <div class="field">
        <label for="password">New password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" required minlength="10" maxlength="200">
        <span class="field-hint">At least 10 characters.</span>
        <% if (fieldErrors.password) { %><span class="field-error"><%= fieldErrors.password %></span><% } %>
      </div>

      <div class="field">
        <label for="confirm_password">Confirm new password</label>
        <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" required minlength="10" maxlength="200">
        <% if (fieldErrors.confirm_password) { %><span class="field-error"><%= fieldErrors.confirm_password %></span><% } %>
      </div>

      <button type="submit" class="btn btn--primary" style="width: 100%; margin-top: var(--space-4);">Update password</button>
    </form>
  </div>
</div>