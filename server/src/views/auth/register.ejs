<div class="auth-layout">
  <!-- Left Panel with Background Image -->
  <div class="auth-layout__panel" style="background-image: url('/images/register-1.webp'); background-size: cover; background-position: center; position: relative;">
    <!-- Dark green overlay to make text readable -->
    <div style="position: absolute; inset: 0; background: rgba(15, 76, 58, 0.35); z-index: 1;"></div>
    <div class="auth-layout__brand" style="position: relative; z-index: 2;">
      <h1 class="auth-layout__title">Join the HOSA network.</h1>
      <p class="auth-layout__lede">
        Reconnect with classmates, find a mentor, and help build the next generation of Highway alumni.
      </p>
    </div>
  </div>

  <div class="auth-layout__form" style="max-height: 90vh; overflow-y: auto;">
    <h2>Create your account</h2>

    <% if (Object.keys(fieldErrors).length > 0) { %>
      <div class="alert alert--error" role="alert">
        <strong>Please fix the following:</strong>
        <ul style="margin: var(--space-2) 0 0 var(--space-4); padding: 0;">
          <% Object.entries(fieldErrors).forEach(([k, msg]) => { %>
            <li><%= k.replace(/_/g, ' ') %>: <%= msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form method="post" action="/register" novalidate>
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">

      <!-- Email -->
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" value="<%= values.email || '' %>">
        <% if (fieldErrors.email) { %><span class="field-error"><%= fieldErrors.email %></span><% } %>
      </div>

      <!-- Names -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
        <div class="field">
          <label for="first_name">First name</label>
          <input id="first_name" name="first_name" type="text" autocomplete="given-name" required maxlength="80" value="<%= values.first_name || '' %>">
          <% if (fieldErrors.first_name) { %><span class="field-error"><%= fieldErrors.first_name %></span><% } %>
        </div>
        <div class="field">
          <label for="last_name">Last name</label>
          <input id="last_name" name="last_name" type="text" autocomplete="family-name" required maxlength="80" value="<%= values.last_name || '' %>">
          <% if (fieldErrors.last_name) { %><span class="field-error"><%= fieldErrors.last_name %></span><% } %>
        </div>
      </div>

      <div class="field">
        <label for="other_name">Other name</label>
        <input id="other_name" name="other_name" type="text" required maxlength="80" value="<%= values.other_name || '' %>">
        <% if (fieldErrors.other_name) { %><span class="field-error"><%= fieldErrors.other_name %></span><% } %>
      </div>

      <!-- Graduation & District -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
        <div class="field">
          <label for="graduation_year">Graduation year</label>
          <input id="graduation_year" name="graduation_year" type="number" min="1950" max="2100" required value="<%= values.graduation_year || '' %>">
          <% if (fieldErrors.graduation_year) { %><span class="field-error"><%= fieldErrors.graduation_year %></span><% } %>
        </div>
        <div class="field">
          <label for="district">District</label>
          <input id="district" name="district" type="text" required maxlength="120" value="<%= values.district || '' %>">
          <% if (fieldErrors.district) { %><span class="field-error"><%= fieldErrors.district %></span><% } %>
        </div>
      </div>

      <!-- Nationality & Region -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
        <div class="field">
          <label for="nationality">Nationality</label>
          <select id="nationality" name="nationality" required>
            <option value="">-- Select Country --</option>
            <option value="Uganda">Uganda</option>
            <option value="Kenya">Kenya</option>
            <option value="Tanzania">Tanzania</option>
            <option value="Rwanda">Rwanda</option>
            <option value="Burundi">Burundi</option>
            <option value="South Sudan">South Sudan</option>
            <option value="DR Congo">DR Congo</option>
          </select>
          <% if (fieldErrors.nationality) { %><span class="field-error"><%= fieldErrors.nationality %></span><% } %>
        </div>
        <div class="field">
          <label for="region">Region</label>
          <select id="region" name="region" required>
            <option value="">-- Select Region --</option>
            <option value="North">North</option>
            <option value="East">East</option>
            <option value="South">South</option>
            <option value="West">West</option>
          </select>
          <% if (fieldErrors.region) { %><span class="field-error"><%= fieldErrors.region %></span><% } %>
        </div>
      </div>

      <!-- Profession & Phone -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
        <div class="field">
          <label for="profession">Profession</label>
          <input id="profession" name="profession" type="text" required maxlength="120" value="<%= values.profession || '' %>">
          <% if (fieldErrors.profession) { %><span class="field-error"><%= fieldErrors.profession %></span><% } %>
        </div>
        <div class="field">
          <label for="phone">Phone Contact</label>
          <input id="phone" name="phone" type="text" required maxlength="40" value="<%= values.phone || '' %>">
          <% if (fieldErrors.phone) { %><span class="field-error"><%= fieldErrors.phone %></span><% } %>
        </div>
      </div>

      <!-- Password -->
      <div class="field">
        <label for="password">Password</label>
        <div style="position: relative;">
          <input id="password" name="password" type="password" autocomplete="new-password" required minlength="5" maxlength="200" style="width: 100%; padding-right: 44px;">
          <button type="button" class="password-toggle" data-target="password" aria-label="Show password" style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: transparent; border: none; cursor: pointer; font-size: 1.2rem; padding: 4px 8px; color: var(--muted);">👁</button>
        </div>
        <span class="field-hint">At least 5 characters.</span>
        <% if (fieldErrors.password) { %><span class="field-error"><%= fieldErrors.password %></span><% } %>
      </div>

      <!-- Confirm Password -->
      <div class="field">
        <label for="confirm_password">Confirm password</label>
        <div style="position: relative;">
          <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" required minlength="5" maxlength="200" style="width: 100%; padding-right: 44px;">
          <button type="button" class="password-toggle" data-target="confirm_password" aria-label="Show password" style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: transparent; border: none; cursor: pointer; font-size: 1.2rem; padding: 4px 8px; color: var(--muted);">👁</button>
        </div>
        <% if (fieldErrors.confirm_password) { %><span class="field-error"><%= fieldErrors.confirm_password %></span><% } %>
      </div>

      <div class="field" style="flex-direction: row; align-items: center; gap: var(--space-2);">
        <input type="checkbox" id="mentor_opt_in" name="mentor_opt_in" value="on" style="min-height: auto;">
        <label for="mentor_opt_in" style="margin: 0; font-weight: normal;">I am willing to mentor current students</label>
      </div>

      <button type="submit" class="btn btn--primary" style="width: 100%; margin-top: var(--space-4);">Create account</button>
    </form>

    <p style="margin-top: var(--space-4); text-align: center; font-size: var(--text-sm);">
      Already have an account? <a href="/login">Log in</a>
    </p>
  </div>
</div>