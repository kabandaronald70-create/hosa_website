<div class="auth-layout">
  <div class="auth-layout__panel">
    <div class="auth-layout__brand">
      <h1 class="auth-layout__title">Forgot your password?</h1>
      <p class="auth-layout__lede">
        Don't worry, it happens to the best of us. Enter your email and we'll send you a link to reset it.
      </p>
    </div>
  </div>

  <div class="auth-layout__form">
    <h2>Reset password</h2>

    <% if (Object.keys(fieldErrors).length > 0) { %>
      <div class="alert alert--error" role="alert">
        <ul style="margin: var(--space-2) 0 0 var(--space-4); padding: 0;">
          <% Object.entries(fieldErrors).forEach(([k, msg]) => { %>
            <li><%= msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form method="post" action="/forgot-password" novalidate>
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">

      <div class="field">
        <label for="email">Email address</label>
        <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" value="<%= values.email || '' %>">
      </div>

      <button type="submit" class="btn btn--primary" style="width: 100%; margin-top: var(--space-4);">Send reset link</button>
    </form>

    <p style="margin-top: var(--space-4); text-align: center; font-size: var(--text-sm);">
      Remembered it? <a href="/login">Log in</a>
    </p>
  </div>
</div>