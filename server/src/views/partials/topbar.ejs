<header class="topbar">
  <div class="topbar__inner">
    <button type="button" class="topbar__menu-toggle" aria-label="Toggle navigation" aria-expanded="false" id="topbar-menu-toggle">
      ☰
    </button>

    <a href="/" class="topbar__brand">
      <img src="/images/web-app-manifest-192x192.png" alt="">
      <span>HOSA</span>
    </a>

        <nav class="topbar__nav" id="topbar-nav" aria-label="Primary">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>" <%= currentPath === '/' ? 'aria-current="page"' : '' %>>Home</a>
      <a href="/directory" class="<%= currentPath.startsWith('/directory') ? 'active' : '' %>" <%= currentPath.startsWith('/directory') ? 'aria-current="page"' : '' %>>Directory</a>
      <a href="/events" class="<%= currentPath.startsWith('/events') ? 'active' : '' %>" <%= currentPath.startsWith('/events') ? 'aria-current="page"' : '' %>>Events</a>
      <a href="/stories" class="<%= currentPath.startsWith('/stories') ? 'active' : '' %>" <%= currentPath.startsWith('/stories') ? 'aria-current="page"' : '' %>>Stories</a>
      <a href="/jobs" class="<%= currentPath.startsWith('/jobs') ? 'active' : '' %>" <%= currentPath.startsWith('/jobs') ? 'aria-current="page"' : '' %>>Jobs</a>
      <a href="/mentorship" class="<%= currentPath.startsWith('/mentorship') ? 'active' : '' %>" <%= currentPath.startsWith('/mentorship') ? 'aria-current="page"' : '' %>>Mentorship</a>
      <a href="/about" class="<%= currentPath.startsWith('/about') ? 'active' : '' %>" <%= currentPath.startsWith('/about') ? 'aria-current="page"' : '' %>>About</a>
    </nav>

    <div class="topbar__actions">
      <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
        <a href="/notifications" class="notif-link" aria-label="Notifications">
          🔔
          <% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %>
            <span class="notif-badge"><%= unreadNotifications %></span>
          <% } %>
        </a>

        <a href="/dashboard" class="topbar__user">
          <% if (currentProfile && currentProfile.avatar_path) { %>
            <img src="/dashboard/avatar/me" alt="" class="topbar__user-avatar" style="object-fit:cover;padding:0;">
          <% } else { %>
            <span class="topbar__user-avatar">
              <%= (currentProfile?.first_name || currentUser.email)[0].toUpperCase() %>
            </span>
          <% } %>
          <span><%= currentProfile?.first_name || currentUser.email %></span>
        </a>
      <% } else { %>
        <a href="/login" class="btn btn--ghost" style="color: var(--ivory); border-color: var(--ivory);">Log in</a>
        <a href="/register" class="btn btn--accent">Join HOSA</a>
      <% } %>
    </div>
  </div>
</header>