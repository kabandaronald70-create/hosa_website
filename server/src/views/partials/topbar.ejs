<% 
  const isAppPage = currentPath.startsWith('/dashboard') || 
                    currentPath.startsWith('/admin') || 
                    currentPath.startsWith('/super') || 
                    currentPath === '/notifications';
%>
<header class="topbar">
  <div class="topbar__inner">
    
    <!-- School Badge & Title -->
    <a href="/" class="topbar__brand" style="min-width: 0;">
      <img src="/images/web-app-manifest-192x192.png" alt="HOSA Crest">
      <span class="topbar__title" style="overflow: hidden; text-overflow: ellipsis;">
        HOSA
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="topbar__nav" id="topbar-nav" aria-label="Primary">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a>
      <a href="/directory" class="<%= currentPath.startsWith('/directory') ? 'active' : '' %>">Directory</a>
      <a href="/events" class="<%= currentPath.startsWith('/events') ? 'active' : '' %>">Events</a>
      <a href="/stories" class="<%= currentPath.startsWith('/stories') ? 'active' : '' %>">Stories</a>
      <a href="/jobs" class="<%= currentPath.startsWith('/jobs') ? 'active' : '' %>">Jobs</a>
      <a href="/businesses" class="<%= currentPath.startsWith('/businesses') ? 'active' : '' %>">Businesses</a>
            <a href="/projects" class="<%= currentPath.startsWith('/projects') ? 'active' : '' %>">Projects</a>
      <a href="/about" class="<%= currentPath.startsWith('/about') ? 'active' : '' %>">About Us</a>
    </nav>

    <!-- Right Side Actions -->
    <div class="topbar__actions">
      
      <!-- Announcement Icon -->
      <a href="/announcements" class="notif-link" aria-label="Announcements" title="Announcements">
        <span class="icon-wrapper">
          📢
          <% if (typeof activeAnnouncements !== 'undefined' && activeAnnouncements > 0) { %>
            <span class="notif-badge"><%= activeAnnouncements %></span>
          <% } %>
        </span>
      </a>

      <% if (isAuthenticated) { %>
        <!-- Notification Icon -->
        <a href="/notifications" class="notif-link" aria-label="Notifications" title="Notifications">
          <span class="icon-wrapper">
            🔔
            <% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %>
              <span class="notif-badge"><%= unreadNotifications %></span>
            <% } %>
          </span>
        </a>

        <!-- User Avatar -->
        <a href="/dashboard" class="topbar__user">
          <% if (currentProfile && currentProfile.avatar_path) { %>
            <img src="/dashboard/avatar/me" alt="" class="topbar__user-avatar" style="object-fit:cover;padding:0;">
          <% } else { %>
            <span class="topbar__user-avatar">
              <%= (currentProfile?.first_name || currentUser.email)[0].toUpperCase() %>
            </span>
          <% } %>
          <span class="topbar__user-name"><%= currentProfile?.first_name || currentUser.email %></span>
        </a>
      <% } else { %>
        <a href="/login" class="btn btn--ghost" style="color: var(--ivory); border-color: var(--ivory);">Log in</a>
      <% } %>

      <!-- Mobile Toggles (Only visible on mobile via CSS) -->
      <div class="mobile-toggles">
        <button type="button" class="mobile-toggle-btn" id="btn-topnav" aria-label="Toggle primary navigation" aria-controls="topbar-nav" aria-expanded="false">
          <span>Topbar</span> Topbar
        </button>
        <% if (isAppPage) { %>
          <button type="button" class="mobile-toggle-btn" id="btn-sidebar" aria-label="Toggle dashboard menu" aria-controls="app-sidebar" aria-expanded="false">
            <span>Sidebar</span> Sidebar
          </button>
        <% } %>
      </div>

    </div>

  </div>
</header>