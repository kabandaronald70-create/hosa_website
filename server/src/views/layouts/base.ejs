<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'HOSA' %></title>
  <link rel="stylesheet" href="/styles/base.css">
</head>
<body>
  <header>
    <nav aria-label="Primary">
      <a href="/">HOSA</a>
      <a href="/health">Health</a>
      <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
  <a href="/dashboard">Dashboard</a>
  <a href="/dashboard/profile">Profile</a>
  <% if (currentUserRoles && currentUserRoles.some(r => r === 'admin' || r === 'super_admin' || r === 'moderator')) { %>
    <a href="/admin">Admin</a>
  <% } %>
  <a href="/notifications" class="notification-bell">
  Notifications
  <% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %>
    <span class="badge" aria-label="<%= unreadNotifications %> unread">
      <%= unreadNotifications %>
    </span>
  <% } %>
</a>
  <form method="post" action="/logout" style="display:inline">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
    <button type="submit">Log out</button>
  </form>
<% } else { %>
        <a href="/login">Log in</a>
        <a href="/register">Register</a>
      <% } %>
    </nav>
  </header>

  <main id="main">
    <% if (typeof flash !== 'undefined' && flash.success) { %>
      <div class="success" role="status"><%= flash.success %></div>
    <% } %>
    <% if (typeof flash !== 'undefined' && flash.error) { %>
      <div class="errors" role="alert"><%= flash.error %></div>
    <% } %>

    <%- body %>
  </main>

  <footer>
    <small>&copy; <%= new Date().getFullYear() %> Highway Old Students’ Association</small>
  </footer>
</body>
</html>