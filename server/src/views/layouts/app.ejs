<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= typeof title !== 'undefined' ? title : 'HOSA' %></title>
  
  <link rel="preload" href="/fonts/manrope-400.ttf" as="font" type="font/ttf" crossorigin>
  <link rel="preload" href="/fonts/manrope-600.ttf" as="font" type="font/ttf" crossorigin>
  <link rel="preload" href="/fonts/fraunces-600.ttf" as="font" type="font/ttf" crossorigin>
  <link rel="icon" type="image/png" sizes="96x96" href="/images/favicon-96x96.png">
  
  <link rel="stylesheet" href="/styles/base.css">
  <link rel="stylesheet" href="/styles/components.css">
  <link rel="stylesheet" href="/styles/layouts.css">
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  
  <%- include('../partials/topbar') %>

  <!-- Mobile Sidebar Overlay -->
  <div class="sidebar-overlay" id="sidebar-overlay"></div>

  <div class="app-layout">
    <%- include('../partials/sidebar') %>

    <main id="main-content" class="app-main">
      <% if (typeof flash !== 'undefined' && flash.success) { %>
        <div class="alert alert--success" role="status" aria-live="polite"><%= flash.success %></div>
      <% } %>
      <% if (typeof flash !== 'undefined' && flash.error) { %>
        <div class="alert alert--error" role="alert"><%= flash.error %></div>
      <% } %>

      <%- body %>
    </main>
  </div>

  <!-- Scripts (Placed at the bottom for performance) -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btnSidebar = document.getElementById('btn-sidebar');
      const topnav = document.getElementById('topbar-nav');
      const sidebar = document.querySelector('.sidebar');
      const overlay = document.getElementById('sidebar-overlay');

      if (btnSidebar && sidebar) {
        btnSidebar.addEventListener('click', (e) => {
          e.preventDefault();
          const isOpen = sidebar.classList.toggle('is-open');
          btnSidebar.setAttribute('aria-expanded', String(isOpen));
          if (overlay) overlay.classList.toggle('is-visible', isOpen);
          if (topnav) topnav.classList.remove('is-open');
          const btnTopnav = document.getElementById('btn-topnav');
          if (btnTopnav) btnTopnav.setAttribute('aria-expanded', 'false');
        });
      }

      if (overlay && sidebar) {
        overlay.addEventListener('click', () => {
          sidebar.classList.remove('is-open');
          overlay.classList.remove('is-visible');
          if (btnSidebar) btnSidebar.setAttribute('aria-expanded', 'false');
        });
      }
    });
  </script>
  
  <script src="/js/public.js"></script>
</body>
</html>