<header style="margin-bottom: var(--space-5);">
  <h1>My Contributions</h1>
  <p>Support HOSA through annual dues and project donations.</p>
</header>

<div style="display: grid; grid-template-columns: 1fr; gap: var(--space-5);">
  
  <!-- Submit New Contribution -->
  <div class="card">
    <h2 style="margin-top: 0;">Make a Contribution</h2>
    <p style="font-size: var(--text-sm); color: var(--muted); margin-bottom: var(--space-4);">
      Submit your payment details below. The Treasurer will verify the transaction against the bank statement. Verified project donations update the selected project's funds raised and progress.
    </p>

    <form method="POST" action="/dashboard/contributions">
      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
      
      <div class="responsive-fields" style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
        <div class="field">
          <label>Amount (UGX)</label>
          <input type="number" name="amount" required min="1" placeholder="e.g. 50000">
        </div>
        <div class="field">
          <label>Purpose</label>
          <select name="purpose" id="purpose-select" required>
            <option value="Annual Subscription" <%= preselectedPurpose === 'Annual Subscription' ? 'selected' : '' %>>Annual Subscription (Dues)</option>
            <option value="Project Donation" <%= preselectedPurpose === 'Project Donation' ? 'selected' : '' %> <%= projects.length === 0 ? 'disabled' : '' %>>Project Donation</option>
            <option value="General Fund" <%= preselectedPurpose === 'General Fund' ? 'selected' : '' %>>General Fund</option>
            <option value="Other" <%= preselectedPurpose === 'Other' ? 'selected' : '' %>>Other</option>
          </select>
        </div>
      </div>

      <!-- Project Dropdown (hidden by default, shown when "Project Donation" is selected) -->
      <div class="field" id="project-field" style="<%= preselectedPurpose === 'Project Donation' ? '' : 'display: none;' %>">
        <label>Select Project</label>
        <select name="project_id" id="project-select" <%= preselectedPurpose === 'Project Donation' ? 'required' : 'disabled' %>>
          <option value="">-- Select an approved project --</option>
          <% projects.forEach(p => { %>
            <option value="<%= p.id %>" <%= preselectedProjectId === p.id ? 'selected' : '' %>>
              <%= p.title %> (<%= p.region %>) — UGX <%= Number(p.funds_raised || 0).toLocaleString() %> raised
            </option>
          <% }) %>
        </select>
        <% if (projects.length === 0) { %>
          <span class="field-hint">There are no approved projects accepting donations right now.</span>
        <% } else { %>
          <span class="field-hint">Choose an approved or in-progress project. Its progress updates after the Treasurer verifies your contribution.</span>
        <% } %>
      </div>

      <div class="responsive-fields" style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
        <div class="field">
          <label>Payment Method</label>
          <select name="payment_method" required>
            <option value="Mobile Money">Mobile Money (MTN/Airtel)</option>
            <option value="Bank Transfer">Bank Transfer</option>
            <option value="Cash">Cash to Treasurer</option>
          </select>
        </div>
        <div class="field">
          <label>Transaction Reference (Optional)</label>
          <input type="text" name="reference" placeholder="e.g. MP123456">
        </div>
      </div>

      <button type="submit" class="btn btn--primary" style="width: 100%; margin-top: var(--space-2);">Submit Contribution</button>
    </form>
  </div>

  <!-- Contribution History -->
  <div class="card">
    <h2 style="margin-top: 0;">My Payment History</h2>
    
    <% if (contributions.length === 0) { %>
      <p style="color: var(--muted);">You have not made any contributions yet.</p>
    <% } else { %>
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Purpose</th>
              <th>Amount</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% contributions.forEach(c => { %>
              <tr>
                <td data-label="Date" style="font-size: var(--text-sm);">
                  <%= new Date(c.created_at).toLocaleDateString('en-GB') %>
                </td>
                <td data-label="Purpose">
                  <strong><%= c.purpose %></strong><br>
                  <% if (c.project_title) { %>
                    <span style="font-size: var(--text-xs); color: var(--green);">Project: <%= c.project_title %></span><br>
                  <% } %>
                  <span style="font-size: var(--text-xs); color: var(--muted);"><%= c.payment_method %> <%= c.reference ? `(${c.reference})` : '' %></span>
                </td>
                <td data-label="Amount">
                  <strong>UGX <%= Number(c.amount).toLocaleString() %></strong>
                </td>
                <td data-label="Status">
                  <span class="badge badge--<%= c.status === 'verified' ? 'success' : c.status === 'pending' ? 'warning' : 'danger' %>">
                    <%= c.status %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>