<header style="margin-bottom: var(--space-5);">
  <h1>Edit Business: <%= business.name %></h1>
  <p>Updating your listing will require admin approval before it goes live again.</p>
</header>

<div class="card" style="max-width: 800px;">
  <form method="POST" action="/dashboard/businesses/<%= business.id %>/edit" enctype="multipart/form-data">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
    
    <div class="field">
      <label>Business Name</label>
      <input type="text" name="name" required value="<%= business.name %>">
    </div>
    
    <div class="field">
      <label>Category</label>
      <select name="category" required>
        <% categories.forEach(c => { %>
          <option value="<%= c %>" <%= business.category === c ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </div>

    <div class="field">
      <label>Description</label>
      <textarea name="description" rows="4" required><%= business.description %></textarea>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
      <div class="field">
        <label>Location</label>
        <input type="text" name="location" required value="<%= business.location %>">
      </div>
      <div class="field">
        <label>Phone</label>
        <input type="text" name="phone" value="<%= business.phone || '' %>">
      </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
      <div class="field">
        <label>Email</label>
        <input type="email" name="email" value="<%= business.email || '' %>">
      </div>
      <div class="field">
        <label>Website</label>
        <input type="url" name="website" value="<%= business.website || '' %>">
      </div>
    </div>

    <div class="field">
      <label>Business Logo (Leave blank to keep current)</label>
      <% if (business.logo_path) { %>
        <div style="margin-bottom: var(--space-2);">
          <img src="<%= business.logo_path %>" alt="Current Logo" style="height: 60px; border-radius: var(--radius-sm);">
        </div>
      <% } %>
      <input type="file" name="logo" accept="image/jpeg,image/png,image/webp">
    </div>

    <div style="display: flex; gap: var(--space-3); margin-top: var(--space-4);">
      <button type="submit" class="btn btn--primary">Save Changes</button>
      <a href="/dashboard/businesses" class="btn btn--ghost">Cancel</a>
    </div>
  </form>
</div>