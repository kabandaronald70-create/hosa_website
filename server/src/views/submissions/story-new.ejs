<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-5); flex-wrap: wrap; gap: var(--space-3);">
  <h1 style="margin: 0;">Submit an alumni story</h1>
  <a href="/dashboard/submissions" class="btn btn--ghost">← Back to submissions</a>
</div>

<p style="color: var(--muted); margin-bottom: var(--space-5);">
  Stories are reviewed by a moderator before appearing on the public site. This usually takes a day or two.
</p>

<% if (Object.keys(fieldErrors).length > 0) { %>
  <div class="alert alert--error" role="alert">
    <strong>Please fix the following:</strong>
    <ul style="margin: var(--space-2) 0 0 var(--space-4); padding: 0;">
      <% Object.entries(fieldErrors).forEach(([k, msg]) => { %>
        <li><%= k.replace(/_/g, ' ') %>: <%= msg %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<div class="card" style="max-width: 800px;">
  <form method="post" action="/dashboard/stories/new" novalidate>
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">

    <div class="field">
      <label for="title">Title</label>
      <input id="title" name="title" type="text" required minlength="5" maxlength="200" value="<%= values.title || '' %>">
      <% if (fieldErrors.title) { %><span class="field-error"><%= fieldErrors.title %></span><% } %>
    </div>

    <div class="field">
      <label for="category">Category (optional)</label>
      <input id="category" name="category" type="text" maxlength="80" placeholder="e.g. Career, Education, Agriculture" value="<%= values.category || '' %>">
    </div>

    <div class="field">
      <label for="excerpt">Short summary (optional, shown on the stories list)</label>
      <textarea id="excerpt" name="excerpt" rows="2" maxlength="500"><%= values.excerpt || '' %></textarea>
    </div>

    <div class="field">
      <label for="body">Story</label>
      <textarea id="body" name="body" rows="10" required minlength="50" maxlength="8000"><%= values.body || '' %></textarea>
      <span class="field-hint">At least 50 characters.</span>
      <% if (fieldErrors.body) { %><span class="field-error"><%= fieldErrors.body %></span><% } %>
    </div>

    <div style="margin-top: var(--space-5);">
      <button type="submit" class="btn btn--primary" style="width: 100%;">Submit for review</button>
    </div>
  </form>
</div>