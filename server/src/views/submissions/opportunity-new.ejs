<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-5); flex-wrap: wrap; gap: var(--space-3);">
  <h1 style="margin: 0;">Submit an opportunity</h1>
  <a href="/dashboard/submissions" class="btn btn--ghost">← Back to submissions</a>
</div>

<p style="color: var(--muted); margin-bottom: var(--space-5);">
  Post a job, internship, scholarship, volunteering role, or training program for HOSA members. Submissions are reviewed before appearing publicly.
</p>

<% if (Object.keys(fieldErrors).length > 0) { %>
  <div class="alert alert--error" role="alert">
    <strong>Please fix the following:</strong>
    <ul style="margin: var(--space-2) 0 0 var(--space-4); padding: 0;">
      <% Object.entries(fieldErrors).forEach(([k, msg]) => { %>
        <li><%= k.replace(/_/g, ' ') %>: <%= msg %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<div class="card" style="max-width: 800px;">
  <form method="post" action="/dashboard/opportunities/new" novalidate>
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">

    <div class="field">
      <label for="title">Title</label>
      <input id="title" name="title" type="text" required minlength="5" maxlength="200" value="<%= values.title || '' %>">
      <% if (fieldErrors.title) { %><span class="field-error"><%= fieldErrors.title %></span><% } %>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
      <div class="field">
        <label for="type_label">Type</label>
        <select id="type_label" name="type_label">
          <option value="">Select type...</option>
          <option value="Job" <%= values.type_label === 'Job' ? 'selected' : '' %>>Job</option>
          <option value="Internship" <%= values.type_label === 'Internship' ? 'selected' : '' %>>Internship</option>
          <option value="Scholarship" <%= values.type_label === 'Scholarship' ? 'selected' : '' %>>Scholarship</option>
          <option value="Volunteering" <%= values.type_label === 'Volunteering' ? 'selected' : '' %>>Volunteering</option>
          <option value="Training" <%= values.type_label === 'Training' ? 'selected' : '' %>>Training</option>
        </select>
      </div>

      <div class="field">
        <label for="deadline">Deadline (optional)</label>
        <input id="deadline" name="deadline" type="date" value="<%= values.deadline || '' %>">
      </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
      <div class="field">
        <label for="employer">Organization / employer</label>
        <input id="employer" name="employer" type="text" maxlength="200" value="<%= values.employer || '' %>">
      </div>

      <div class="field">
        <label for="location">Location</label>
        <input id="location" name="location" type="text" maxlength="200" value="<%= values.location || '' %>">
      </div>
    </div>

    <div class="field">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="6" required minlength="30" maxlength="5000"><%= values.description || '' %></textarea>
      <span class="field-hint">At least 30 characters.</span>
      <% if (fieldErrors.description) { %><span class="field-error"><%= fieldErrors.description %></span><% } %>
    </div>

    <div class="field">
      <label for="application_url">Application link (https://…)</label>
      <input id="application_url" name="application_url" type="url" maxlength="500" placeholder="https://example.com/apply" value="<%= values.application_url || '' %>">
      <% if (fieldErrors.application_url) { %><span class="field-error"><%= fieldErrors.application_url %></span><% } %>
    </div>

    <div style="margin-top: var(--space-5);">
      <button type="submit" class="btn btn--primary" style="width: 100%;">Submit for review</button>
    </div>
  </form>
</div>