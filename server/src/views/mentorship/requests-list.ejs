<h1>Mentorship requests</h1>

<p><a href="/dashboard">← Back to dashboard</a></p>

<section aria-labelledby="sent-heading">
  <h2 id="sent-heading">Requests I sent (<%= sent.length %>)</h2>
  <% if (sent.length === 0) { %>
    <p><em>None yet.</em> <a href="/directory?mentor=1">Find a mentor →</a></p>
  <% } else { %>
    <table>
      <thead>
        <tr><th>Mentor</th><th>Field</th><th>Status</th><th>Sent</th><th></th></tr>
      </thead>
      <tbody>
        <% sent.forEach((r) => { %>
          <tr>
            <td><%= r.display_name || `${r.first_name} ${r.last_name}` %></td>
            <td><%= r.field_of_interest %></td>
            <td><%= r.status %></td>
            <td><%= new Date(r.created_at).toLocaleDateString() %></td>
            <td>
              <% if (['pending','accepted'].includes(r.status)) { %>
                <form method="post" action="/dashboard/mentorship/requests/<%= r.id %>/cancel" style="display:inline">
                  <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
                  <button type="submit" onclick="return confirm('Cancel this request?')">Cancel</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<section aria-labelledby="received-heading" style="margin-top:2rem">
  <h2 id="received-heading">Requests I received (<%= received.length %>)</h2>
  <% if (received.length === 0) { %>
    <p><em>None yet.</em></p>
  <% } else { %>
    <table>
      <thead>
        <tr><th>Requester</th><th>Field</th><th>Goals</th><th>Status</th><th></th></tr>
      </thead>
      <tbody>
        <% received.forEach((r) => { %>
          <tr>
            <td><%= r.display_name || `${r.first_name} ${r.last_name}` %></td>
            <td><%= r.field_of_interest %></td>
            <td><%= r.goals.slice(0, 100) %><%= r.goals.length > 100 ? '…' : '' %></td>
            <td><%= r.status %></td>
            <td>
              <% if (r.status === 'pending') { %>
                <form method="post" action="/dashboard/mentorship/requests/<%= r.id %>/accept" style="display:inline">
                  <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
                  <button type="submit">Accept</button>
                </form>
                <form method="post" action="/dashboard/mentorship/requests/<%= r.id %>/decline" style="display:inline">
                  <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
                  <button type="submit">Decline</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>