<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-5); flex-wrap: wrap; gap: var(--space-3);">
  <h1 style="margin: 0;">Mentorship requests</h1>
  <a href="/dashboard" class="btn btn--ghost">← Back to dashboard</a>
</div>

<!-- Requests I Sent -->
<section style="margin-bottom: var(--space-7);">
  <h2 style="font-size: var(--text-xl); border-bottom: 2px solid var(--line); padding-bottom: var(--space-2); margin-bottom: var(--space-4);">
    Requests I sent <span style="color: var(--muted); font-size: var(--text-base); font-weight: normal;">(<%= sent.length %>)</span>
  </h2>

  <% if (sent.length === 0) { %>
    <div class="empty-state" style="padding: var(--space-5);">
      <p style="margin: 0; color: var(--muted);">You haven't sent any requests yet. <a href="/directory?mentor=1">Find a mentor →</a></p>
    </div>
  <% } else { %>
    <div style="display: flex; flex-direction: column; gap: var(--space-3);">
      <% sent.forEach((r) => { %>
        <article class="card" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-3);">
          <div>
            <h3 style="margin: 0 0 var(--space-1); font-size: var(--text-lg);"><%= r.display_name || `${r.first_name} ${r.last_name}` %></h3>
            <p style="margin: 0; color: var(--muted); font-size: var(--text-sm);">
              Field: <strong><%= r.field_of_interest %></strong> · Sent <%= new Date(r.created_at).toLocaleDateString('en-GB') %>
            </p>
          </div>
          
          <div style="display: flex; align-items: center; gap: var(--space-3);">
            <% if (r.status === 'pending') { %><span class="badge badge--warning">Pending</span>
            <% } else if (r.status === 'accepted') { %><span class="badge badge--success">Accepted</span>
            <% } else if (r.status === 'declined') { %><span class="badge badge--danger">Declined</span>
            <% } else { %><span class="badge badge--muted"><%= r.status %></span><% } %>

            <% if (['pending', 'accepted'].includes(r.status)) { %>
              <form method="post" action="/dashboard/mentorship/requests/<%= r.id %>/cancel" style="margin: 0;">
                <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
                <button type="submit" class="btn btn--ghost btn--sm" onclick="return confirm('Cancel this request?')">Cancel</button>
              </form>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<!-- Requests I Received -->
<section>
  <h2 style="font-size: var(--text-xl); border-bottom: 2px solid var(--line); padding-bottom: var(--space-2); margin-bottom: var(--space-4);">
    Requests I received <span style="color: var(--muted); font-size: var(--text-base); font-weight: normal;">(<%= received.length %>)</span>
  </h2>

  <% if (received.length === 0) { %>
    <div class="empty-state" style="padding: var(--space-5);">
      <p style="margin: 0; color: var(--muted);">No one has requested mentorship from you yet.</p>
    </div>
  <% } else { %>
    <div style="display: flex; flex-direction: column; gap: var(--space-3);">
      <% received.forEach((r) => { %>
        <article class="card">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-3);">
            <div>
              <h3 style="margin: 0 0 var(--space-1); font-size: var(--text-lg);"><%= r.display_name || `${r.first_name} ${r.last_name}` %></h3>
              <p style="margin: 0; color: var(--muted); font-size: var(--text-sm);">Field: <strong><%= r.field_of_interest %></strong></p>
            </div>
            
            <% if (r.status === 'pending') { %><span class="badge badge--warning">Pending</span>
            <% } else if (r.status === 'accepted') { %><span class="badge badge--success">Accepted</span>
            <% } else if (r.status === 'declined') { %><span class="badge badge--danger">Declined</span>
            <% } else { %><span class="badge badge--muted"><%= r.status %></span><% } %>
          </div>

          <div style="background: var(--ivory); padding: var(--space-3); border-radius: var(--radius-sm); margin-bottom: var(--space-3);">
            <p style="margin: 0; font-size: var(--text-sm);"><strong>Goals:</strong> <%= r.goals %></p>
          </div>

          <% if (r.status === 'pending') { %>
            <div style="display: flex; gap: var(--space-2);">
              <form method="post" action="/dashboard/mentorship/requests/<%= r.id %>/accept" style="margin: 0;">
                <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
                <button type="submit" class="btn btn--primary btn--sm">Accept</button>
              </form>
              <form method="post" action="/dashboard/mentorship/requests/<%= r.id %>/decline" style="margin: 0;">
                <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
                <button type="submit" class="btn btn--danger btn--sm">Decline</button>
              </form>
            </div>
          <% } %>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>