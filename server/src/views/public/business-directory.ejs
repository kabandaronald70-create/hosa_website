<header style="margin-bottom: var(--space-6); display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: var(--space-4);">
  <div>
    <h1>Alumni Business Directory</h1>
    <p>Discover and support businesses owned by fellow Highway alumni.</p>
  </div>
  <a href="/dashboard/businesses" class="btn btn--accent">List Your Business</a>
</header>

<!-- ACTIVE CAMPAIGN BANNER -->
<% if (activeCampaign && campaignBusinesses.length > 0) { %>
  <div class="card" style="background: var(--gold-100); border: 2px solid var(--gold); margin-bottom: var(--space-6); text-align: center; padding: var(--space-6);">
    <h2 style="color: var(--gold-700); margin-top: 0; font-size: var(--text-2xl);">🌟 <%= activeCampaign.title %></h2>
    <p style="font-size: var(--text-lg); margin-bottom: var(--space-4);"><%= activeCampaign.description %></p>
    
    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3);">
      <% campaignBusinesses.forEach(cb => { %>
        <div class="card" style="width: 200px; padding: var(--space-3); text-align: left;">
          <h3 style="font-size: var(--text-base); margin: 0 0 var(--space-1);"><%= cb.name %></h3>
          <span style="font-size: var(--text-xs); color: var(--muted);"><%= cb.category %></span>
        </div>
      <% }) %>
    </div>
  </div>
<% } %>

<!-- Search Form (Only ONE form tag now) -->
<form method="GET" action="/businesses" style="display: flex; gap: var(--space-3); margin-bottom: var(--space-5); flex-wrap: wrap;">
  <input type="text" name="q" value="<%= filters.search %>" placeholder="Search businesses or services..." style="flex-grow: 1; min-width: min(100%, 200px);">
  <select name="category" style="max-width: 100%;">
    <option value="">All Categories</option>
    <% categories.forEach(c => { %>
      <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
    <% }) %>
  </select>
  <button type="submit" class="btn btn--primary">Search</button>
</form>

<% 
  // Separate featured and regular businesses
  const now = new Date();
  const featuredBusinesses = businesses.filter(b => b.featured_until && new Date(b.featured_until) > now);
  const regularBusinesses = businesses.filter(b => !b.featured_until || new Date(b.featured_until) <= now);
%>

<% if (businesses.length === 0) { %>
  <div class="empty-state">
    <p class="empty-state__title">No businesses found.</p>
  </div>
<% } else { %>

  <!-- Featured Businesses -->
<% if (featuredBusinesses.length > 0) { %>
  <h2 class="business-section-title business-section-title--featured">
    ⭐ Featured Businesses
  </h2>

  <div class="business-grid">
    <% featuredBusinesses.forEach(b => { %>
      <article class="business-card business-card--featured">
        <div class="business-card__hero">
          <% if (b.logo_path) { %>
            <img class="business-card__image" src="<%= b.logo_path %>" alt="<%= b.name %>" loading="lazy">
          <% } else { %>
            <div class="business-card__image business-card__image--fallback">
              <span><%= (b.name || "B").charAt(0).toUpperCase() %></span>
            </div>
          <% } %>

          <div class="business-card__overlay">
            <span class="business-card__featured-label">⭐ Featured</span>
            <div class="business-card__hero-content">
              <span class="business-card__category"><%= b.category %></span>
              <h2 class="business-card__title"><%= b.name %></h2>
              <p class="business-card__location">
                <span aria-hidden="true">📍</span> <%= b.location %>
              </p>
            </div>
          </div>
        </div>

        <div class="business-card__body">
          <p class="business-card__description"><%= b.description %></p>

          <% if (b.website) { %>
            <a href="<%= b.website %>" target="_blank" rel="noopener noreferrer"
               class="btn btn--accent business-card__website">Visit Website ↗</a>
          <% } %>

          <div class="business-card__owner">
            <h3>Owned by</h3>
            <p class="business-card__owner-name">
              <%= [b.first_name, b.last_name].filter(Boolean).join(" ") || "HOSA Member" %>
            </p>

            <% if (b.phone) { %>
              <a class="business-card__contact"
                 href="tel:<%= b.phone.replace(/[^\d+]/g, '') %>">
                <span aria-hidden="true">☎</span> <%= b.phone %>
              </a>
            <% } %>

            <% if (b.email) { %>
              <a class="business-card__contact" href="mailto:<%= b.email %>">
                <span aria-hidden="true">✉</span> <%= b.email %>
              </a>
            <% } %>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>

<!-- All Other Businesses -->
<% if (regularBusinesses.length > 0) { %>
  <h2 class="business-section-title">All Businesses</h2>

  <div class="business-grid">
    <% regularBusinesses.forEach(b => { %>
      <article class="business-card">
        <div class="business-card__hero">
          <% if (b.logo_path) { %>
            <img class="business-card__image" src="<%= b.logo_path %>" alt="<%= b.name %>" loading="lazy">
          <% } else { %>
            <div class="business-card__image business-card__image--fallback">
              <span><%= (b.name || "B").charAt(0).toUpperCase() %></span>
            </div>
          <% } %>

          <div class="business-card__overlay">
            <div class="business-card__hero-content">
              <span class="business-card__category"><%= b.category %></span>
              <h2 class="business-card__title"><%= b.name %></h2>
              <p class="business-card__location">
                <span aria-hidden="true">📍</span> <%= b.location %>
              </p>
            </div>
          </div>
        </div>

        <div class="business-card__body">
          <p class="business-card__description"><%= b.description %></p>

          <% if (b.website) { %>
            <a href="<%= b.website %>" target="_blank" rel="noopener noreferrer"
               class="btn btn--ghost business-card__website">Visit Website ↗</a>
          <% } %>

          <div class="business-card__owner">
            <h3>Owned by</h3>
            <p class="business-card__owner-name">
              <%= [b.first_name, b.last_name].filter(Boolean).join(" ") || "HOSA Member" %>
            </p>

            <% if (b.phone) { %>
              <a class="business-card__contact"
                 href="tel:<%= b.phone.replace(/[^\d+]/g, '') %>">
                <span aria-hidden="true">☎</span> <%= b.phone %>
              </a>
            <% } %>

            <% if (b.email) { %>
              <a class="business-card__contact" href="mailto:<%= b.email %>">
                <span aria-hidden="true">✉</span> <%= b.email %>
              </a>
            <% } %>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>

<% } %>