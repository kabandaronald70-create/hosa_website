<header style="margin-bottom: var(--space-6);">
  <h1>Alumni Directory</h1>
  <p>Find and connect with former students of Highway Secondary School.</p>
</header>

<div class="directory-layout">
  <aside class="card filter-sidebar" style="align-self: start;">
    <h2 style="font-size: var(--text-lg); margin-bottom: var(--space-3);">Filters</h2>
    
    <form method="GET" action="/directory">
      <div class="filter-grid">
        <div class="field" style="margin-bottom: 0;">
          <label for="q">Search by name</label>
          <input type="search" id="q" name="q" value="<%= filters.q %>" placeholder="e.g. Sarah">
        </div>

        <div class="field" style="margin-bottom: 0;">
          <label for="district">District</label>
          <select id="district" name="district">
            <option value="">All districts</option>
            <% districts.forEach((d) => { %>
              <option value="<%= d %>" <%= filters.district === d ? 'selected' : '' %>><%= d %></option>
            <% }) %>
          </select>
        </div>

        <div class="field" style="margin-bottom: 0;">
          <label for="profession">Profession</label>
          <select id="profession" name="profession">
            <option value="">All professions</option>
            <% professions.forEach((p) => { %>
              <option value="<%= p %>" <%= filters.profession === p ? 'selected' : '' %>><%= p %></option>
            <% }) %>
          </select>
        </div>

        <div class="field" style="flex-direction: row; align-items: center; gap: var(--space-2); margin-bottom: 0; padding-top: var(--space-4);">
          <input type="checkbox" id="mentor" name="mentor" value="1" <%= filters.mentorOnly ? 'checked' : '' %> style="min-height: auto;">
          <label for="mentor" style="margin: 0; font-weight: normal;">Mentors only</label>
        </div>
      </div>

      <div class="filter-actions">
        <button type="submit" class="btn btn--primary" style="width: 100%;">Apply</button>
        <a href="/directory" class="btn btn--ghost" style="width: 100%; text-align: center;">Reset</a>
      </div>
    </form>
  </aside>

  <div class="directory-results">
    <p style="color: var(--muted); margin-bottom: var(--space-4);">
      <strong><%= pagination.total %></strong> member<%= pagination.total === 1 ? '' : 's' %> found
    </p>

    <% if (members.length === 0) { %>
      <div class="empty-state">
        <p class="empty-state__title">No alumni match your filters.</p>
        <p>Try broadening your search.</p>
        <a href="/directory" class="btn btn--ghost" style="margin-top: var(--space-4);">Clear filters</a>
      </div>
    <% } else { %>
      <div class="directory-card-grid">
        <% members.forEach((m) => { %>
          
          <article class="card directory-card">
            <div>
              <!-- Avatar + Name -->
              <div class="card__header">
                <% if (m.avatar_path) { %>
                  <img
                    src="/dashboard/avatar/<%= m.user_id %>"
                    alt="<%= m.first_name %> <%= m.last_name %>"
                    class="directory-card__avatar"
                  >
                <% } else { %>
                  <div class="directory-card__avatar directory-card__avatar--placeholder">
                    <%= (m.first_name || m.display_name || '?')[0].toUpperCase() %>
                  </div>
                <% } %>
                <div class="directory-card__identity">
                  <strong class="directory-card__name">
                    <%= m.display_name || `${m.first_name} ${m.last_name}` %>
                  </strong>
                  <p class="directory-card__class">
                    Class of <%= m.graduation_year || '—' %>
                  </p>
                </div>
              </div>

              <!-- Profession + Organization -->
              <% if (m.profession || m.organization) { %>
                <p class="directory-card__profession">
                  <% if (m.profession) { %><strong><%= m.profession %></strong><% } %>
                  <% if (m.organization) { %><br><span style="color: var(--muted);"><%= m.organization %></span><% } %>
                </p>
              <% } %>

              <!-- Contact & details list -->
              <ul class="directory-card__details">
                <% if (m.district) { %>
                  <li>📍 <%= m.district %><% if (m.country_code) { %>, <%= m.country_code %><% } %></li>
                <% } %>
                <% if (m.phone) { %>
                  <li>📞 <a href="tel:<%= m.phone %>"><%= m.phone %></a></li>
                <% } %>
                <% if (m.account_email) { %>
                  <li>✉️ <a href="mailto:<%= m.account_email %>"><%= m.account_email %></a></li>
                <% } %>
              </ul>

              <!-- Mentor badge -->
              <% if (m.mentor_opt_in) { %>
                <span class="badge badge--gold directory-card__mentor">
                  Mentor<% if (m.mentor_field) { %> · <%= m.mentor_field %><% } %>
                </span>
              <% } %>
            </div>
            
            <!-- Actions -->
            <div class="directory-card__actions">
              <a href="/directory/<%= m.seed_ref || m.user_id %>" class="btn btn--ghost">View Profile</a>
              
              <% if (currentUser) { %>
                <button type="button" class="btn btn--ghost directory-card__save" data-save="member" data-id="<%= m.user_id %>" data-action="save" title="Save Profile">☆</button>
              <% } %>
            </div>
          </article>
          
        <% }) %>
      </div>

      <% if (pagination.pages > 1) { %>
        <nav class="pagination" aria-label="Pagination">
          <% if (pagination.page > 1) { %>
            <a href="?<%= new URLSearchParams({ ...filters, page: pagination.page - 1 }).toString() %>">← Prev</a>
          <% } %>
          <span class="active"><%= pagination.page %> / <%= pagination.pages %></span>
          <% if (pagination.page < pagination.pages) { %>
            <a href="?<%= new URLSearchParams({ ...filters, page: pagination.page + 1 }).toString() %>">Next →</a>
          <% } %>
        </nav>
      <% } %>
    <% } %>
  </div>
</div>

<style>
  .directory-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    min-width: 0;
    width: 100%;
  }

  .filter-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .filter-grid > .field {
    min-width: 0;
  }

  .filter-grid > .field:first-child {
    grid-column: 1 / -1;
  }

  .filter-grid select {
    width: 100%;
    min-width: 0;
  }

  .filter-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .directory-results {
    min-width: 0;
    width: 100%;
  }

  .directory-card-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: stretch;
    justify-items: stretch;
    gap: var(--space-4);
    width: 100%;
    max-width: 100%;
    margin-inline: auto;
  }

  .directory-card {
    display: flex;
    min-width: 0;
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
  }

  .directory-card__avatar {
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    border: 2px solid var(--gold);
    border-radius: 50%;
    object-fit: cover;
  }

  .directory-card__avatar--placeholder {
    display: grid;
    place-items: center;
    background: var(--gold);
    color: var(--ink);
    font-weight: 600;
  }

  .directory-card__identity {
    min-width: 0;
  }

  .directory-card__name {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .directory-card__class {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .directory-card__profession {
    margin: var(--space-3) 0 var(--space-1);
    font-size: var(--text-sm);
  }

  .directory-card__details {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: var(--space-2) 0 0;
    padding: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    list-style: none;
  }

  .directory-card__details a {
    overflow-wrap: anywhere;
  }

  .directory-card__mentor {
    display: inline-block;
    margin-top: var(--space-2);
  }

  .directory-card__actions {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .directory-card__actions > a {
    flex-grow: 1;
  }

  .directory-card__save {
    padding-inline: var(--space-3);
  }

  @media (min-width: 640px) {
    .filter-grid {
      grid-template-columns: 1fr;
    }

    .filter-grid > .field:first-child {
      grid-column: auto;
    }

    .filter-actions {
      grid-template-columns: 1fr;
    }

    .directory-card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .directory-card-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .directory-layout {
      grid-template-columns: 260px 1fr;
    }
    .filter-sidebar {
      position: sticky;
      top: calc(var(--topbar-h) + var(--space-4));
    }
  }

  @media (max-width: 359px) {
    .filter-grid,
    .filter-actions {
      grid-template-columns: 1fr;
    }

    .filter-grid > .field:first-child {
      grid-column: auto;
    }
  }
</style>