<header style="margin-bottom: var(--space-6);">
  <h1>Alumni Stories</h1>
  <p>Journeys from Highway Secondary School to the world.</p>
</header>

<% if (stories.length === 0) { %>
  <div class="empty-state">
    <p class="empty-state__title">No stories published yet.</p>
    <p>Check back soon to read about the incredible journeys of our alumni.</p>
  </div>
<% } else { %>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: var(--space-5);">
    <% stories.forEach((s) => { %>
      
      <article class="card" style="display: flex; flex-direction: column; justify-content: space-between; height: 100%;">
        
        <div>
          <% if (s.category) { %>
            <span class="badge badge--gold" style="margin-bottom: var(--space-3);"><%= s.category %></span>
          <% } %>
          
          <h2 style="font-size: var(--text-xl); margin: 0 0 var(--space-3); line-height: 1.2;">
            <%= s.title %>
          </h2>
          
          <% if (s.excerpt) { %>
            <p style="color: var(--muted); font-size: var(--text-sm); margin-bottom: var(--space-4);">
              <%= s.excerpt %>
            </p>
          <% } %>
        </div>

        <div style="margin-top: var(--space-4); display: flex; gap: var(--space-2); align-items: center;">
          <a href="/stories/<%= s.slug %>" class="btn btn--ghost" style="flex-grow: 1; text-align: center;">Read Story</a>
          
          <% if (currentUser) { %>
            <button type="button" class="btn btn--ghost" data-save="story" data-id="<%= s.slug %>" style="padding-inline: var(--space-3); color: #D2691E; border-color: #D2691E;" title="Save Story">☆</button>
            
            <a href="/report?type=story&id=<%= s.id %>" 
               class="btn btn--ghost" 
               style="padding-inline: var(--space-3); color: var(--danger); border-color: transparent;" 
               title="Report this story">
              ⚠ Report
            </a>
          <% } %>
        </div>

      </article>
      
    <% }) %>
  </div>

  <!-- Pagination -->
  <% if (pagination && pagination.pages > 1) { %>
    <nav class="pagination" aria-label="Pagination">
      <% if (pagination.page > 1) { %>
        <a href="?page=<%= pagination.page - 1 %>">← Prev</a>
      <% } %>
      <span class="active"><%= pagination.page %> / <%= pagination.pages %></span>
      <% if (pagination.page < pagination.pages) { %>
        <a href="?page=<%= pagination.page + 1 %>">Next →</a>
      <% } %>
    </nav>
  <% } %>
<% } %>