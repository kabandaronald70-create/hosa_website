<p style="max-width: 900px; margin: var(--space-4) auto;">
  <a href="/directory" class="btn btn--ghost">← Back to directory</a>
</p>

<article class="card" style="max-width: 900px; margin: 0 auto var(--space-6); padding: 0; overflow: hidden;">
  <div style="display: flex; flex-direction: row; flex-wrap: wrap;">
    
    <!-- LEFT COLUMN: Square Avatar -->
    <div style="flex: 0 0 300px; background: var(--ivory); padding: var(--space-5); display: flex; justify-content: center; align-items: flex-start; border-right: 1px solid var(--line);">
      <% if (member.avatar_path) { %>
        <img 
          src="/dashboard/avatar/<%= member.user_id %>" 
          alt="<%= member.first_name %>" 
          style="width: 100%; max-width: 250px; aspect-ratio: 1 / 1; object-fit: cover; border-radius: var(--radius-md); box-shadow: var(--shadow-md);"
        >
      <% } else { %>
        <div style="width: 100%; max-width: 250px; aspect-ratio: 1 / 1; border-radius: var(--radius-md); background: var(--gold); color: var(--ink); display: grid; place-items: center; font-size: 5rem; font-weight: 700; box-shadow: var(--shadow-md);">
          <%= (member.first_name || '?')[0].toUpperCase() %>
        </div>
      <% } %>
    </div>

    <!-- RIGHT COLUMN: Member Details -->
    <div style="flex: 1 1 400px; padding: var(--space-6);">
      
      <h1 style="margin-top: 0; font-size: var(--text-3xl); color: var(--green-700);">
        <%= member.display_name || `${member.first_name} ${member.last_name}` %>
      </h1>
      
      <% if (member.mentor_opt_in) { %>
        <span class="badge badge--gold" style="margin-bottom: var(--space-4); display: inline-block;">Available for Mentorship</span>
      <% } %>

      <div style="display: flex; flex-direction: column; gap: var(--space-2); font-size: var(--text-base);">
        
        <p style="margin: 0; border-bottom: 1px solid var(--line); padding-bottom: var(--space-2);">
          <strong style="color: var(--muted); display: inline-block; width: 120px;">Name:</strong> 
          <%= member.first_name %> <%= member.last_name %>
        </p>

        <p style="margin: 0; border-bottom: 1px solid var(--line); padding-bottom: var(--space-2);">
          <strong style="color: var(--muted); display: inline-block; width: 120px;">Class:</strong> 
          <%= member.graduation_year || '—' %>
        </p>

        <p style="margin: 0; border-bottom: 1px solid var(--line); padding-bottom: var(--space-2);">
          <strong style="color: var(--muted); display: inline-block; width: 120px;">District:</strong> 
          <%= member.district ? `${member.district}${member.country_code ? ', ' + member.country_code : ''}` : '—' %>
        </p>

        <p style="margin: 0; border-bottom: 1px solid var(--line); padding-bottom: var(--space-2);">
          <strong style="color: var(--muted); display: inline-block; width: 120px;">Email:</strong> 
          <% if (member.account_email) { %>
            <a href="mailto:<%= member.account_email %>"><%= member.account_email %></a>
          <% } else { %>
            <span style="color: var(--muted); font-style: italic;">Hidden by privacy settings</span>
          <% } %>
        </p>

        <p style="margin: 0; border-bottom: 1px solid var(--line); padding-bottom: var(--space-2);">
          <strong style="color: var(--muted); display: inline-block; width: 120px;">Phone:</strong> 
          <%= member.phone || '—' %>
        </p>

        <p style="margin: 0; border-bottom: 1px solid var(--line); padding-bottom: var(--space-2);">
          <strong style="color: var(--muted); display: inline-block; width: 120px;">Profession:</strong> 
          <%= member.profession || '—' %>
          <% if (member.organization) { %> at <%= member.organization %><% } %>
        </p>

        <% if (member.biography) { %>
          <div style="margin-top: var(--space-2);">
            <strong style="color: var(--muted); display: block; margin-bottom: var(--space-1);">Biography:</strong> 
            <p style="margin: 0; line-height: 1.6;"><%= member.biography %></p>
          </div>
        <% } %>

      </div>

      <% if (member.mentor_opt_in && currentUser) { %>
        <a href="/dashboard/mentorship/requests/new?mentor=<%= member.user_id %>" class="btn btn--primary" style="margin-top: var(--space-5); width: 100%;">
          Request Mentorship
        </a>
      <% } %>

    </div>
  </div>
</article>