<header style="margin-bottom: var(--space-6);">
  <h1>Announcements</h1>
  <p>Latest news and updates from the HOSA committee.</p>
</header>

<% if (announcements.length === 0) { %>
  <div class="empty-state">
    <p class="empty-state__title"><%= currentUser ? 'No unread announcements.' : 'No announcements this week.' %></p>
    <p><%= currentUser ? 'You are all caught up.' : 'Check back soon for news and updates.' %></p>
  </div>
<% } else { %>
  <div class="stack" style="max-width: 800px;">
    <% announcements.forEach((a) => { %>
      <article class="card" style="<%= a.pinned ? 'border-left: 4px solid var(--gold);' : '' %>">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
          <div>
            <h2 style="margin: 0 0 var(--space-2); font-size: var(--text-xl);">
              <%= a.title %>
              <% if (a.pinned) { %><span class="badge badge--gold">Pinned</span><% } %>
            </h2>
            <p style="font-size: var(--text-xs); color: var(--muted); margin-bottom: var(--space-4);">
              Posted by <%= a.author_name || 'Admin' %> on <%= new Date(a.created_at).toLocaleDateString('en-GB') %>
            </p>
          </div>
        </div>
        <p style="white-space: pre-wrap; font-size: var(--text-base);"><%= a.body %></p>
        <% if (currentUser) { %>
          <form method="post" action="/announcements/<%= a.id %>/read" style="margin-top: var(--space-4);">
            <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
            <button type="submit" class="btn btn--primary">Mark as read</button>
          </form>
        <% } %>
      </article>
    <% }) %>
  </div>
<% } %>