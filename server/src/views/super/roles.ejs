<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-5); flex-wrap: wrap; gap: var(--space-3);">
  <div style="display: flex; align-items: center; gap: var(--space-3);">
    <a href="/admin" class="btn btn--ghost" style="padding: var(--space-2);">←</a>
    <h1 style="margin: 0;">Role Management</h1>
  </div>
</div>

<div class="role-management-grid">
  
  <!-- Current Admins -->
  <section>
    <h2 style="font-size: var(--text-lg); margin-bottom: var(--space-3);">Current Admins</h2>
    <div class="card role-management-table">
      <table class="data-table">
        <thead>
          <tr><th>Name</th><th>Role</th><th></th></tr>
        </thead>
        <tbody>
          <% admins.forEach(a => { %>
            <tr>
              <td data-label="Name">
                <strong><%= a.first_name %> <%= a.last_name %></strong><br>
                <small style="color: var(--muted);"><%= a.email %></small>
              </td>
              <td data-label="Role">
                <% if (a.role === 'super_admin') { %>
                  <span class="badge badge--danger">Super Admin</span>
                <% } else { %>
                  <span class="badge badge--warning">Admin</span>
                <% } %>
              </td>
              <td style="text-align: right;">
                <% if (a.role !== 'super_admin' || a.id !== currentUser.id) { %>
                  <form method="post" action="/super/roles/<%= a.id %>" style="margin: 0;">
                    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
                    <input type="hidden" name="role" value="member">
                    <button type="submit" class="btn btn--ghost btn--sm" style="color: var(--danger);" onclick="return confirm('Demote this admin to a regular member?')">Demote</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Promote Members -->
  <section>
    <h2 style="font-size: var(--text-lg); margin-bottom: var(--space-3);">Promote a Member</h2>
    <div class="card role-management-table role-management-table--members">
      <table class="data-table">
        <thead>
          <tr><th>Name</th><th></th></tr>
        </thead>
        <tbody>
          <% if (members.length === 0) { %>
            <tr><td colspan="2">No regular members found.</td></tr>
          <% } else { %>
            <% members.forEach(m => { %>
              <tr>
                <td data-label="Name">
                  <strong><%= m.first_name %> <%= m.last_name %></strong><br>
                  <small style="color: var(--muted);"><%= m.email %></small>
                </td>
                <td style="text-align: right;">
                  <form method="post" action="/super/roles/<%= m.id %>" style="margin: 0;">
                    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
                    <input type="hidden" name="role" value="admin">
                    <button type="submit" class="btn btn--primary btn--sm">Make Admin</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>
</div>

<style>
  .role-management-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--space-5);
  }

  .role-management-grid > section {
    min-width: 0;
  }

  .role-management-table {
    padding: 0;
    overflow-x: auto;
  }

  .role-management-table--members {
    max-height: 500px;
    overflow-y: auto;
  }

  @media (max-width: 767px) {
    .role-management-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }

    .role-management-table .data-table {
      min-width: 0;
    }

    .role-management-table thead {
      display: none;
    }

    .role-management-table table,
    .role-management-table tbody {
      display: block;
      width: 100%;
    }

    .role-management-table tbody tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-2) var(--space-3);
      padding: var(--space-3);
      border-bottom: 1px solid var(--line);
    }

    .role-management-table tbody tr:last-child {
      border-bottom: 0;
    }

    .role-management-table tbody td {
      min-width: 0;
      padding: 0;
      border: 0;
    }

    .role-management-table tbody td:first-child {
      grid-column: 1 / -1;
    }

    .role-management-table tbody td[data-label="Name"] {
      overflow-wrap: anywhere;
    }

    .role-management-table tbody td[data-label="Name"] small {
      display: inline-block;
      max-width: 100%;
      overflow-wrap: anywhere;
    }

    .role-management-table tbody tr > td[colspan] {
      grid-column: 1 / -1;
    }
  }
</style>