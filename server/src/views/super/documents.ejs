<div class="page-heading">
  <h1 style="margin: 0;">Manage Documents</h1>
  <a href="/admin" class="btn btn--ghost">← Back to Admin</a>
</div>

<div
  class="responsive-columns"
  style="display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--space-5);"
>
  <!-- Upload Form -->
  <div class="card" style="align-self: start;">
    <h2 style="font-size: var(--text-lg); margin-top: 0;">
      Upload Document
    </h2>

    <form
      method="post"
      action="/super/documents"
      enctype="multipart/form-data"
    >
      <input
        type="hidden"
        name="<%= csrfField %>"
        value="<%= csrfToken %>"
      >

      <div class="field">
        <label for="title">Title</label>
        <input
          id="title"
          name="title"
          type="text"
          maxlength="200"
          required
        >
      </div>

      <div class="field">
        <label for="description">Description (optional)</label>
        <textarea
          id="description"
          name="description"
          rows="3"
        ></textarea>
      </div>

      <div class="field">
        <label for="access_level">Who can access this document?</label>

        <select id="access_level" name="access_level" required>
          <option value="super_admin_only" selected>
            Super admins only
          </option>
          <option value="leadership_only">
            Current HOSA leadership and super admins
          </option>
          <option value="approved_members">
            All approved HOSA members and super admins
          </option>
        </select>

        <small style="display: block; margin-top: var(--space-1); color: var(--muted);">
          New documents are restricted to super admins by default.
        </small>
      </div>

      <div class="field">
        <label for="document">File (Max 10MB)</label>
        <input
          id="document"
          name="document"
          type="file"
          required
          style="padding: var(--space-2) 0;"
        >
      </div>

      <button
        type="submit"
        class="btn btn--primary"
        style="width: 100%;"
      >
        Upload
      </button>
    </form>
  </div>

  <!-- Uploaded Documents -->
  <div>
    <h2 style="font-size: var(--text-lg);">
      Uploaded Documents
    </h2>

    <% if (documents.length === 0) { %>
      <div class="empty-state">
        <p>No documents uploaded yet.</p>
      </div>
    <% } else { %>
      <div style="display: flex; flex-direction: column; gap: var(--space-3);">

        <% documents.forEach((doc) => { %>
          <div class="card document-row">

            <div class="document-row__details">
              <h3 style="margin: 0 0 var(--space-1); font-size: var(--text-base);">
                <%= doc.title %>
              </h3>

              <p style="margin: 0; font-size: var(--text-xs); color: var(--muted);">
                <%= doc.file_name %>
                · Uploaded
                <%= new Date(doc.created_at).toLocaleDateString() %>
              </p>

              <p style="margin: var(--space-2) 0 0; font-size: var(--text-sm);">
                <strong>Current access:</strong>

                <% if (doc.access_level === "leadership_only") { %>
                  Current HOSA leadership and super admins
                <% } else if (doc.access_level === "approved_members") { %>
                  All approved HOSA members and super admins
                <% } else { %>
                  Super admins only
                <% } %>
              </p>
            </div>

            <!-- Change Access Level -->
            <form
              method="post"
              action="/super/documents/<%= doc.id %>/access-level"
              style="display: flex; flex-wrap: wrap; align-items: end; gap: var(--space-2); margin-top: var(--space-3);"
            >
              <input
                type="hidden"
                name="<%= csrfField %>"
                value="<%= csrfToken %>"
              >

              <div class="field" style="flex: 1 1 220px; margin: 0;">
                <label for="access-level-<%= doc.id %>">
                  Change access
                </label>

                <select
                  id="access-level-<%= doc.id %>"
                  name="access_level"
                  required
                >
                  <option
                    value="super_admin_only"
                    <%= doc.access_level === "super_admin_only" ? "selected" : "" %>
                  >
                    Super admins only
                  </option>

                  <option
                    value="leadership_only"
                    <%= doc.access_level === "leadership_only" ? "selected" : "" %>
                  >
                    Current HOSA leadership and super admins
                  </option>

                  <option
                    value="approved_members"
                    <%= doc.access_level === "approved_members" ? "selected" : "" %>
                  >
                    All approved HOSA members and super admins
                  </option>
                </select>
              </div>

              <button
                type="submit"
                class="btn btn--primary btn--sm"
              >
                Update access
              </button>
            </form>

            <!-- Document Actions -->
            <div
              class="document-actions"
              style="display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3);"
            >
              <a
                href="/documents/<%= doc.id %>/view"
                target="_blank"
                rel="noopener"
                class="btn btn--ghost btn--sm"
              >
                View
              </a>

              <a
                href="/documents/<%= doc.id %>/download"
                class="btn btn--ghost btn--sm"
              >
                Download
              </a>

              <form
                method="post"
                action="/super/documents/<%= doc.id %>/delete"
                style="margin: 0;"
              >
                <input
                  type="hidden"
                  name="<%= csrfField %>"
                  value="<%= csrfToken %>"
                >

                <button
                  type="submit"
                  class="btn btn--danger btn--sm"
                  onclick="return confirm('Delete this document?')"
                >
                  Delete
                </button>
              </form>
            </div>

          </div>
        <% }) %>

      </div>
    <% } %>
  </div>
</div>