<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-5); flex-wrap: wrap; gap: var(--space-3);">
  <div>
    <h1 style="margin: 0;">Regional Dashboard</h1>
    <p style="color: var(--muted); margin: var(--space-1) 0 0; font-size: var(--text-sm);">
      You are managing the <strong><%= region %></strong> region.
    </p>
  </div>
  <div style="display: flex; gap: var(--space-2);">
    <a href="/regional/reports" class="btn btn--ghost">View Reports</a>
    <a href="/regional/proposals/new" class="btn btn--primary">+ New Proposal</a>
  </div>
</div>

<!-- Approval statistics -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-6);">
  <div class="card" style="border-left: 4px solid var(--warning);">
    <p style="color: var(--muted); font-size: var(--text-sm); margin: 0;">Pending Review</p>
    <h2 style="margin: var(--space-1) 0 0; color: var(--warning);"><%= stats.pendingProposals %></h2>
  </div>
  <div class="card" style="border-left: 4px solid var(--success);">
    <p style="color: var(--muted); font-size: var(--text-sm); margin: 0;">Approved</p>
    <h2 style="margin: var(--space-1) 0 0; color: var(--success);"><%= stats.approvedProjects %></h2>
  </div>
  <div class="card" style="border-left: 4px solid var(--danger);">
    <p style="color: var(--muted); font-size: var(--text-sm); margin: 0;">Rejected</p>
    <h2 style="margin: var(--space-1) 0 0; color: var(--danger);"><%= stats.rejectedProposals %></h2>
  </div>
  <div class="card" style="border-left: 4px solid var(--primary);">
    <p style="color: var(--muted); font-size: var(--text-sm); margin: 0;">Active Projects</p>
    <h2 style="margin: var(--space-1) 0 0; color: var(--primary);"><%= stats.activeProjects %></h2>
  </div>
  <div class="card" style="border-left: 4px solid var(--success);">
    <p style="color: var(--muted); font-size: var(--text-sm); margin: 0;">Completed</p>
    <h2 style="margin: var(--space-1) 0 0; color: var(--success);"><%= stats.completedProjects %></h2>
  </div>
</div>

<h2 style="margin-bottom: var(--space-2);">My Regional Proposals</h2>
<p style="color: var(--muted); margin-bottom: var(--space-4);">
  Track the review progress and decisions for proposals you have submitted.
</p>

<% if (projects.length === 0) { %>
  <div class="empty-state">
    <p class="empty-state__title">You have not submitted any proposals yet.</p>
    <p>Submit a regional project proposal to begin the approval process.</p>
    <a href="/regional/proposals/new" class="btn btn--primary">Submit a Proposal</a>
  </div>
<% } else { %>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-4);">
    <% projects.forEach(p => { %>
      <article class="card" style="display: flex; flex-direction: column;">
        <% if (p.image_path) { %>
          <img
            src="<%= p.image_path %>"
            alt="<%= p.title %>"
            style="width: 100%; height: 160px; object-fit: cover; border-radius: var(--radius-sm); margin-bottom: var(--space-3);"
          >
        <% } %>

        <div style="flex-grow: 1;">
          <span class="badge badge--<%= p.approval_status === 'approved' ? 'success' : p.approval_status === 'rejected' ? 'danger' : 'warning' %>">
            <%= p.approval_status === 'approved' ? 'Approved' : p.approval_status === 'rejected' ? 'Rejected' : 'Pending Review' %>
          </span>

          <h3 style="margin: var(--space-2) 0;"><%= p.title %></h3>

          <p style="font-size: var(--text-sm); color: var(--muted);">
            Budget: UGX <%= Number(p.budget || 0).toLocaleString() %>
          </p>

          <p style="font-size: var(--text-sm);">
            <%= (p.description || "").slice(0, 140) %><%= (p.description || "").length > 140 ? "..." : "" %>
          </p>

          <% if (p.approval_status === "pending") { %>
            <div style="margin-top: var(--space-3); padding: var(--space-3); background: var(--surface, #f5f5f5); border-radius: var(--radius-sm);">
              <p style="margin: 0; font-size: var(--text-sm);">
                <strong>Awaiting:</strong>
                <%= p.approval_stage === "projects_manager" ? "Projects Manager review" : p.approval_stage === "chairperson" ? "Chairperson review" : p.approval_stage === "super_admin" ? "Super Admin review" : "Approval review" %>
              </p>
            </div>
          <% } else if (p.approval_status === "rejected") { %>
            <div style="margin-top: var(--space-3); padding: var(--space-3); border-left: 3px solid var(--danger); background: var(--surface, #f5f5f5); border-radius: var(--radius-sm);">
              <p style="margin: 0 0 var(--space-1); color: var(--danger);">
                <strong>Reason for rejection</strong>
              </p>
              <p style="margin: 0; font-size: var(--text-sm);"><%= p.rejection_reason || "No reason was provided." %></p>
            </div>
          <% } else if (p.approval_status === "approved") { %>
            <p style="margin-top: var(--space-3); color: var(--success); font-size: var(--text-sm);">
              All approval stages completed.
            </p>
          <% } %>
        </div>

        <div style="margin-top: var(--space-3);">
          <span style="font-size: var(--text-xs); color: var(--muted);">
            Project status: <%= (p.status || "").replaceAll("_", " ") %>
          </span>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>

<!-- Regional Expense Requests -->
<section style="margin-top: var(--space-7);">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-4);">
    <div>
      <h2 style="margin: 0;">My Expense Requests</h2>
      <p style="color: var(--muted); font-size: var(--text-sm); margin: var(--space-1) 0 0;">
        Submit requests and track their progress through the HOSA approval process.
      </p>
    </div>
  </div>

  <!-- Submit expense request -->
  <div class="card" style="padding: var(--space-4); margin-bottom: var(--space-5);">
    <h3 style="margin-top: 0;">Submit an Expense Request</h3>

    <form method="POST" action="/regional/expenses"
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-3);">

      <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">

      <div class="field" style="margin: 0;">
        <label for="regional-expense-title">Expense Title</label>
        <input
          id="regional-expense-title"
          type="text"
          name="title"
          maxlength="150"
          required
          placeholder="e.g. Regional outreach meeting"
        >
      </div>

      <div class="field" style="margin: 0;">
        <label for="regional-expense-amount">Amount (UGX)</label>
        <input
          id="regional-expense-amount"
          type="number"
          name="amount"
          min="1"
          step="1"
          required
          placeholder="e.g. 250000"
        >
      </div>

      <div class="field" style="margin: 0;">
        <label for="regional-expense-category">Category</label>
        <select id="regional-expense-category" name="category" required>
          <option value="Administration">Administration</option>
          <option value="Events">Events</option>
          <option value="Projects">Projects</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <div class="field" style="margin: 0;">
        <label for="regional-expense-description">Description</label>
        <textarea
          id="regional-expense-description"
          name="description"
          maxlength="2000"
          rows="2"
          placeholder="Explain the purpose of this expense"
        ></textarea>
      </div>

      <div style="grid-column: 1 / -1;">
        <button type="submit" class="btn btn--primary">
          Submit Expense Request
        </button>
      </div>
    </form>
  </div>

  <!-- Expense request history -->
  <% if (!expenses || expenses.length === 0) { %>
    <div class="card" style="padding: var(--space-5); text-align: center;">
      <h3>No Expense Requests Yet</h3>
      <p style="color: var(--muted);">
        Expense requests you submit will appear here with their approval progress.
      </p>
    </div>
  <% } else { %>

    <div style="display: grid; gap: var(--space-4);">
      <% expenses.forEach((expense) => {
        const expenseStatus =
          expense.status === "rejected"
            ? "Rejected"
            : expense.status === "paid"
              ? "Paid — Closed"
              : expense.status === "approved" && expense.approval_stage === "payment"
                ? "Approved — Awaiting Payment"
                : expense.approval_stage === "projects_manager"
                  ? "Awaiting Projects Manager"
                  : expense.approval_stage === "treasurer"
                    ? "Awaiting Treasurer"
                    : expense.approval_stage === "chairperson"
                      ? "Awaiting Chairperson"
                      : expense.approval_stage === "super_admin"
                        ? "Awaiting Super Admin"
                        : "Under Review";

        const canEditExpense =
          expense.status === "pending" &&
          expense.approval_stage === "projects_manager" &&
          expense.submitted_role === "regional_outreach_officer";
      %>

        <article class="card" style="padding: var(--space-4);">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-3); flex-wrap: wrap;">
            <div>
              <h3 style="margin: 0 0 var(--space-2);"><%= expense.title %></h3>
              <p style="margin: 0; color: var(--muted); font-size: var(--text-sm);">
                <%= expense.category %> · Submitted <%= new Date(expense.created_at).toLocaleString() %>
              </p>
            </div>

            <span class="badge badge--<%= expense.status === 'rejected' ? 'danger' : expense.status === 'paid' ? 'success' : expense.status === 'approved' ? 'success' : 'warning' %>">
              <%= expenseStatus %>
            </span>
          </div>

          <p style="font-weight: 600; margin: var(--space-3) 0;">
            UGX <%= Number(expense.amount || 0).toLocaleString() %>
          </p>

          <% if (expense.description) { %>
            <p style="font-size: var(--text-sm);"><%= expense.description %></p>
          <% } %>

          <% if (expense.status === "rejected") { %>
            <div style="padding: var(--space-3); margin-top: var(--space-3); border-left: 3px solid var(--danger); background: var(--surface, #f5f5f5);">
              <strong style="color: var(--danger);">Reason for rejection</strong>
              <p style="margin-bottom: 0;"><%= expense.rejection_reason || "No reason was provided." %></p>
            </div>
          <% } %>

          <% if (canEditExpense) { %>
            <div style="display: flex; gap: var(--space-2); flex-wrap: wrap; margin-top: var(--space-3);">
              <a href="/regional/expenses/<%= expense.id %>/edit" class="btn btn--ghost btn--sm">
                Edit Request
              </a>

              <form
                method="POST"
                action="/regional/expenses/<%= expense.id %>/delete"
                onsubmit="return confirm('Delete this expense request? This action cannot be undone.');"
              >
                <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
                <button type="submit" class="btn btn--danger btn--sm">
                  Delete Request
                </button>
              </form>
            </div>
          <% } %>

          <!-- Private approval history: visible only on the submitting officer's dashboard -->
          <div style="margin-top: var(--space-4); border-top: 1px solid var(--border, #ddd); padding-top: var(--space-3);">
            <h4 style="margin-top: 0;">Approval History</h4>

            <% if (!expense.approvalHistory || expense.approvalHistory.length === 0) { %>
              <p style="font-size: var(--text-sm); color: var(--muted);">
                No approval activity has been recorded yet.
              </p>
            <% } else { %>
              <ol style="padding-left: 20px; margin-bottom: 0;">
                <% expense.approvalHistory.forEach((entry) => {
                  const actionLabels = {
                    submitted: "Expense request submitted",
                    projects_manager_approved: "Projects Manager approved",
                    treasurer_approved: "Treasurer approved",
                    chairperson_approved: "Chairperson approved",
                    super_admin_approved: "Super Admin approved",
                    rejected: "Expense request rejected",
                    paid: "Expense marked as paid"
                  };

                  const actorName = [entry.actor_first_name, entry.actor_last_name]
                    .filter(Boolean)
                    .join(" ");
                %>
                  <li style="margin-bottom: var(--space-2); font-size: var(--text-sm);">
                    <strong><%= actionLabels[entry.action] || entry.action.replaceAll("_", " ") %></strong>
                    <% if (actorName) { %>
                      — <%= actorName %>
                    <% } %>
                    <span style="color: var(--muted);">
                      · <%= new Date(entry.created_at).toLocaleString() %>
                    </span>

                    <% if (entry.comments) { %>
                      <p style="margin: 4px 0 0; color: var(--muted);"><%= entry.comments %></p>
                    <% } %>
                  </li>
                <% }) %>
              </ol>
            <% } %>
          </div>
        </article>

      <% }) %>
    </div>
  <% } %>
</section>
