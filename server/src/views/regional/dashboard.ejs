<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-5); flex-wrap: wrap; gap: var(--space-3);">
  <div>
    <h1 style="margin: 0;">Regional Dashboard</h1>
    <p style="color: var(--muted); margin: var(--space-1) 0 0; font-size: var(--text-sm);">
      You are managing the <strong><%= region %></strong> region.
    </p>
  </div>
  <div style="display: flex; gap: var(--space-2);">
    <a href="/regional/reports" class="btn btn--ghost">View Reports</a>
    <a href="/regional/proposals/new" class="btn btn--primary">+ New Proposal</a>
  </div>
</div>

<!-- Approval statistics -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-6);">
  <div class="card" style="border-left: 4px solid var(--warning);">
    <p style="color: var(--muted); font-size: var(--text-sm); margin: 0;">Pending Review</p>
    <h2 style="margin: var(--space-1) 0 0; color: var(--warning);"><%= stats.pendingProposals %></h2>
  </div>
  <div class="card" style="border-left: 4px solid var(--success);">
    <p style="color: var(--muted); font-size: var(--text-sm); margin: 0;">Approved</p>
    <h2 style="margin: var(--space-1) 0 0; color: var(--success);"><%= stats.approvedProjects %></h2>
  </div>
  <div class="card" style="border-left: 4px solid var(--danger);">
    <p style="color: var(--muted); font-size: var(--text-sm); margin: 0;">Rejected</p>
    <h2 style="margin: var(--space-1) 0 0; color: var(--danger);"><%= stats.rejectedProposals %></h2>
  </div>
  <div class="card" style="border-left: 4px solid var(--primary);">
    <p style="color: var(--muted); font-size: var(--text-sm); margin: 0;">Active Projects</p>
    <h2 style="margin: var(--space-1) 0 0; color: var(--primary);"><%= stats.activeProjects %></h2>
  </div>
  <div class="card" style="border-left: 4px solid var(--success);">
    <p style="color: var(--muted); font-size: var(--text-sm); margin: 0;">Completed</p>
    <h2 style="margin: var(--space-1) 0 0; color: var(--success);"><%= stats.completedProjects %></h2>
  </div>
</div>

<h2 style="margin-bottom: var(--space-2);">My Regional Proposals</h2>
<p style="color: var(--muted); margin-bottom: var(--space-4);">
  Track the review progress and decisions for proposals you have submitted.
</p>

<% if (projects.length === 0) { %>
  <div class="empty-state">
    <p class="empty-state__title">You have not submitted any proposals yet.</p>
    <p>Submit a regional project proposal to begin the approval process.</p>
    <a href="/regional/proposals/new" class="btn btn--primary">Submit a Proposal</a>
  </div>
<% } else { %>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-4);">
    <% projects.forEach(p => { %>
      <article class="card" style="display: flex; flex-direction: column;">
        <% if (p.image_path) { %>
          <img
            src="<%= p.image_path %>"
            alt="<%= p.title %>"
            style="width: 100%; height: 160px; object-fit: cover; border-radius: var(--radius-sm); margin-bottom: var(--space-3);"
          >
        <% } %>

        <div style="flex-grow: 1;">
          <span class="badge badge--<%= p.approval_status === 'approved' ? 'success' : p.approval_status === 'rejected' ? 'danger' : 'warning' %>">
            <%= p.approval_status === 'approved' ? 'Approved' : p.approval_status === 'rejected' ? 'Rejected' : 'Pending Review' %>
          </span>

          <h3 style="margin: var(--space-2) 0;"><%= p.title %></h3>

          <p style="font-size: var(--text-sm); color: var(--muted);">
            Budget: UGX <%= Number(p.budget || 0).toLocaleString() %>
          </p>

          <p style="font-size: var(--text-sm);">
            <%= (p.description || "").slice(0, 140) %><%= (p.description || "").length > 140 ? "..." : "" %>
          </p>

          <% if (p.approval_status === "pending") { %>
            <div style="margin-top: var(--space-3); padding: var(--space-3); background: var(--surface, #f5f5f5); border-radius: var(--radius-sm);">
              <p style="margin: 0; font-size: var(--text-sm);">
                <strong>Awaiting:</strong>
                <%= p.approval_stage === "projects_manager" ? "Projects Manager review" : p.approval_stage === "chairperson" ? "Chairperson review" : p.approval_stage === "super_admin" ? "Super Admin review" : "Approval review" %>
              </p>
            </div>
          <% } else if (p.approval_status === "rejected") { %>
            <div style="margin-top: var(--space-3); padding: var(--space-3); border-left: 3px solid var(--danger); background: var(--surface, #f5f5f5); border-radius: var(--radius-sm);">
              <p style="margin: 0 0 var(--space-1); color: var(--danger);">
                <strong>Reason for rejection</strong>
              </p>
              <p style="margin: 0; font-size: var(--text-sm);"><%= p.rejection_reason || "No reason was provided." %></p>
            </div>
          <% } else if (p.approval_status === "approved") { %>
            <p style="margin-top: var(--space-3); color: var(--success); font-size: var(--text-sm);">
              All approval stages completed.
            </p>
          <% } %>
        </div>

        <div style="margin-top: var(--space-3);">
          <span style="font-size: var(--text-xs); color: var(--muted);">
            Project status: <%= (p.status || "").replaceAll("_", " ") %>
          </span>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>
