<div
  style="
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-5);
  "
>
  <h1 style="margin: 0">Submit Regional Report</h1>
  <a href="/regional/reports" class="btn btn--ghost">← Back to Reports</a>
</div>

<div class="card" style="max-width: 700px">
  <form method="post" action="/regional/reports" enctype="multipart/form-data">
    <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>" />

    <div class="field">
      <label>Report Title</label>
      <input
        type="text"
        name="title"
        required
        placeholder="e.g. Q3 2026 Regional Activity Report"
      />
    </div>

    <div class="field">
      <label>Report Type</label>
      <select name="report_type" required>
        <option value="">Select report type</option>
        <option value="Monthly Report">Monthly Report</option>
        <option value="Quarterly Report">Quarterly Report</option>
        <option value="Annual Report">Annual Report</option>
        <option value="Incident Report">Incident Report</option>
      </select>
    </div>

    <div class="field">
      <label>Report Content</label>
      <textarea
        name="content"
        rows="8"
        required
        placeholder="Summarize activities, member mobilization, challenges, and recommendations..."
      ></textarea>
    </div>

    <div class="field">
      <label>Attach Document (Optional PDF)</label>
      <input type="file" name="file" accept=".pdf,application/pdf" />
      <small class="field__hint">
        PDF documents only. Maximum file size: 10 MB.
      </small>
    </div>

    <div
      style="
        background: var(--ivory);
        padding: var(--space-3);
        border-radius: var(--radius-sm);
        margin-bottom: var(--space-4);
      "
    >
      <p style="margin: 0; font-size: var(--text-sm)">
        <strong>Region:</strong> <%= region %>
      </p>
    </div>

    <button type="submit" class="btn btn--primary" style="width: 100%">
      Submit Report
    </button>
  </form>
</div>
