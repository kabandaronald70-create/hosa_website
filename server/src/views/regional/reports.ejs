<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-5);">
  <div>
    <h1 style="margin: 0;">Regional Reports</h1>
    <p style="color: var(--muted); margin: var(--space-1) 0 0; font-size: var(--text-sm);">
      Reports submitted for the <strong><%= region %></strong> region.
    </p>
  </div>
  <div style="display: flex; gap: var(--space-2);">
    <a href="/regional/dashboard" class="btn btn--ghost">← Back to Dashboard</a>
    <a href="/regional/reports/new" class="btn btn--primary">+ Submit Report</a>
  </div>
</div>

<% if (reports.length === 0) { %>
  <div class="empty-state">
    <p class="empty-state__title">No reports submitted yet.</p>
    <p>Submit your first report to keep the executive committee updated.</p>
  </div>
<% } else { %>
  <div style="display: flex; flex-direction: column; gap: var(--space-4);">
    <% reports.forEach(r => { %>
      <article class="card">
        <div style="display: flex; justify-content: space-between; align-items: start;">
          <div>
            <span class="badge badge--<%= r.status === 'reviewed' ? 'success' : 'warning' %>"><%= r.status %></span>
            <span class="badge badge--gold" style="margin-left: 4px;"><%= r.report_type %></span>
            <h3 style="margin: var(--space-2) 0 0;"><%= r.title %></h3>
          </div>
          <span style="font-size: var(--text-xs); color: var(--muted);">
            <%= new Date(r.created_at).toLocaleDateString() %>
          </span>
        </div>
        <p style="margin: var(--space-3) 0; white-space: pre-wrap;"><%= r.content %></p>
        
        <% if (r.file_name) { %>
          <div style="background: var(--ivory); padding: var(--space-2); border-radius: var(--radius-sm); display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: var(--text-sm);">📎 <%= r.file_name %></span>
          <a
  href="/regional/reports/<%= r.id %>/attachment"
  class="btn btn--ghost btn--sm"
>
  Download
</a>
          </div>
        <% } %>

        <!-- Edit & Delete Actions (Only if Pending) -->
        <% if (r.status === 'pending') { %>
          <div style="margin-top: var(--space-4); padding-top: var(--space-3); border-top: 1px dashed var(--line); display: flex; justify-content: flex-end; gap: var(--space-2);">
            
            <!-- Edit Button -->
            <a href="/regional/reports/<%= r.id %>/edit" class="btn btn--ghost btn--sm">
              ✏️ Edit
            </a>

            <!-- Delete Form -->
            <form method="POST" action="/regional/reports/<%= r.id %>/delete" onsubmit="return confirm('Are you sure you want to delete this report? This action cannot be undone.');">
              <input type="hidden" name="<%= csrfField %>" value="<%= csrfToken %>">
              <button type="submit" class="btn btn--danger btn--sm" style="background-color: #fee2e2; color: #dc2626; border: 1px solid #fecaca; padding: 0.4rem 0.8rem; border-radius: var(--radius-sm); cursor: pointer;">
                🗑️ Delete
              </button>
            </form>
            
          </div>
        <% } %>

      </article>
    <% }) %>
  </div>
<% } %>