# --- Server ---
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173

# --- PostgreSQL (local Windows install) ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=hosa_dev

# --- Sessions ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-hex-string
SESSION_NAME=hosa.sid
SESSION_MAX_AGE_MS=604800000

# --- CSRF ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CSRF_SECRET=replace-with-a-long-random-hex-string
CSRF_COOKIE_NAME=hosa.csrf
CSRF_HEADER_NAME=x-csrf-token
CSRF_FIELD_NAME=_csrf

# --- Supabase Storage ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_AVATAR_BUCKET=avatars
SUPABASE_SIGNED_URL_TTL_SECONDS=60

# --- Logging ---
LOG_LEVEL=info