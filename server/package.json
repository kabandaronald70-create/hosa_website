{
  "name": "hosa-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HOSA alumni platform backend (Express + PostgreSQL)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node db/migrate.js",
    "migrate:status": "node db/migrate.js --status"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "compression": "^1.7.5",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
